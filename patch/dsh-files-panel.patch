+    await api.terminal.write(request({ sessionId: sessionId as never, terminalId: TID, data: 'ls\r' }), new AbortController().signal)
+    await api.terminal.signal(request({ sessionId: sessionId as never, terminalId: TID, signal: 'SIGINT' }), new AbortController().signal)
+    const close = await api.terminal.close(request({ sessionId: sessionId as never, terminalId: TID }), new AbortController().signal)
+    expect(close.result).toMatchObject({ ok: true, value: { closed: true } })
