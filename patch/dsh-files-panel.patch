+/** Package-owned invariant companion for the workspace-files `-fs` backend. @module @deepseek-ai/dsh-host-workspace-files-fs/invariant */
+
+import type { Context } from '@deepseek-ai/cordis'
+import type { InvariantInstaller } from '@deepseek-ai/dsh-invariants'
+
+const PACKAGE_NAME = '@deepseek-ai/dsh-host-workspace-files-fs'
+
+/** Cordis companion plugin name. */
+export const name = 'host-workspace-files-fs-invariant'
+/** Service required before the companion can reserve package ownership. */
+export const inject = ['invariants']
+
+/**
+ * No runtime invariant: the backend owns no event or durable-data relationship
+ * of its own — the filesystem capability and the API gateway already observe
+ * every read it issues.
+ */
+const install: InvariantInstaller = () => {}
+
+/**
+ * Register the workspace-files `-fs` invariant companion.
+ * @param ctx - Cordis context carrying the invariant service.
+ * @returns the installed registration's disposer after setup succeeds.
+ */
+export const apply = (ctx: Context): Promise<() => void> =>
+  Promise.resolve(ctx.invariants.register(PACKAGE_NAME, install))
diff --git a/packages/host/workspace-files-fs/tests/mapping.spec.ts b/packages/host/workspace-files-fs/tests/mapping.spec.ts
new file mode 100644
index 0000000000..b98ca8e308
--- /dev/null
+++ b/packages/host/workspace-files-fs/tests/mapping.spec.ts
@@ -0,0 +1,171 @@
+/** Error-mapping and boundary branches over a scripted stub filesystem. */
+
+import { describe, expect, it } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import { FileSystem, FsError, FsTargetKey, FsVersion } from '@deepseek-ai/dsh-fs'
+import type { FsDirEntry, FsEditOutcome, FsInfo, FsPathInfo, FsTarget, FsWriteIntent, FsWriteOutcome } from '@deepseek-ai/dsh-fs'
+import { WorkspaceFilesError } from '@deepseek-ai/dsh-host-workspace-files'
+import FsWorkspaceFiles from '../src/index.ts'
+
+/** What one stub backend run returns (values) or throws (anything else). */
+interface StubBehavior {
+  stat?: FsInfo | undefined
+  listDir?: FsDirEntry[] | unknown
+  readText?: string | unknown
+  writeText?: FsWriteOutcome | unknown
+}
+
+/** Scripted backend: each slot is a value to return or a value to throw. */
+class StubFileSystem extends FileSystem {
+  resolveCalls: (AbortSignal | undefined)[] = []
+
+  constructor(ctx: Context, private readonly behavior: StubBehavior) {
+    super(ctx)
+  }
+
+  async resolve(_path: string, opts?: { cwd?: string; signal?: AbortSignal }): Promise<FsTarget> {
+    this.resolveCalls.push(opts?.signal)
+    return { targetKey: FsTargetKey('stub'), displayPath: '/stub' }
+  }
+
+  processPath(): string { return '/stub' }
+  fileUrl(): string { return 'file:///stub' }
+  contains(): boolean { return false }
+
+  async stat(): Promise<FsInfo | undefined> { return this.behavior.stat }
+
+  async lstat(): Promise<FsPathInfo | undefined> { return undefined }
+
+  async readText(): Promise<string> {
+    if (typeof this.behavior.readText === 'string') return this.behavior.readText
+    throw this.behavior.readText
+  }
+
+  async streamText(): Promise<AsyncIterable<string>> { throw new Error('unused') }
+
+  async readBytes(): Promise<Uint8Array> { throw new Error('unused') }
+
+  async listDir(): Promise<FsDirEntry[]> {
+    if (Array.isArray(this.behavior.listDir)) return this.behavior.listDir
+    throw this.behavior.listDir
+  }
+
+  async writeText(_target: FsTarget, _content: string, _expected?: FsWriteIntent, _signal?: AbortSignal): Promise<FsWriteOutcome> {
+    const value = this.behavior.writeText
+    if (typeof value === 'object' && value !== null && 'version' in value) return value as FsWriteOutcome
+    throw value
+  }
+
+  async editText(): Promise<FsEditOutcome> { throw new Error('unused') }
+}
+
+const DIR_INFO: FsInfo = { version: FsVersion('stub-v'), type: 'directory' }
+const FILE_INFO: FsInfo = { version: FsVersion('stub-v'), type: 'file' }
+
+async function mount(behavior: StubBehavior): Promise<{ service: FsWorkspaceFiles; fs: StubFileSystem }> {
+  const ctx = new Context()
+  const fsFiber = ctx.plugin(StubFileSystem, behavior)
+  const serviceFiber = ctx.plugin(FsWorkspaceFiles, { maxEntries: 10, maxReadBytes: 64 })
+  await fsFiber.await()
+  await serviceFiber.await()
+  return { service: ctx.get('workspaceFiles') as FsWorkspaceFiles, fs: ctx.get('fs') as StubFileSystem }
+}
+
+describe('error mapping over the stub backend', () => {
+  it('maps every fs failure code to the seam vocabulary', async () => {
+    const cases: Array<[unknown, string]> = [
+      [new FsError('gone', 'FS_NOT_FOUND'), 'files-not-found'],
+      [new FsError('locked', 'FS_PERMISSION_DENIED'), 'files-permission-denied'],
+      [new FsError('confined', 'FS_SANDBOX_DENIED'), 'files-permission-denied'],
+      [new FsError('big', 'FS_TOO_LARGE'), 'files-too-large'],
+      [new FsError('moved', 'FS_STALE_VERSION'), 'files-stale-version'],
+    ]
+    for (const [thrown, code] of cases) {
+      const { service } = await mount({ stat: DIR_INFO, listDir: thrown })
+      await expect(service.list('/x')).rejects.toMatchObject({ name: 'WorkspaceFilesError', code, path: '/x' })
+    }
+  })
+
+  it('maps a non-directory fs failure to files-not-directory on list', async () => {
+    const { service } = await mount({ stat: DIR_INFO, listDir: new FsError('kind', 'FS_NOT_DIRECTORY') })
+    await expect(service.list('/x')).rejects.toMatchObject({ code: 'files-not-directory' })
+  })
+
+  it('maps non-regular-file failures to files-not-file on read', async () => {
+    const { service } = await mount({ stat: FILE_INFO, readText: new FsError('kind', 'FS_NOT_REGULAR_FILE') })
+    await expect(service.read('/x')).rejects.toMatchObject({ code: 'files-not-file' })
+  })
+
+  it('folds non-FsError throws into files-io-error with a message', async () => {
+    const { service } = await mount({ stat: DIR_INFO, listDir: new Error('boom') })
+    const boom = await service.list('/x').then(
+      () => { throw new Error('unreachable') },
+      (caught: unknown) => caught as WorkspaceFilesError,
+    )
+    expect(boom).toMatchObject({ code: 'files-io-error', path: '/x' })
+    expect(boom.message).toContain('boom')
+
+    const raw = await mount({ stat: DIR_INFO, listDir: 'raw' })
+    const rawError = await raw.service.list('/x').then(
+      () => { throw new Error('unreachable') },
+      (caught: unknown) => caught as WorkspaceFilesError,
+    )
+    expect(rawError).toMatchObject({ code: 'files-io-error' })
+    expect(rawError.message).toContain('raw')
+  })
+})
+
+describe('boundary branches over the stub backend', () => {
+  it('passes the caller signal into resolve on list and read', async () => {
+    const controller = new AbortController()
+    const listed = await mount({ stat: DIR_INFO, listDir: [] })
+    await listed.service.list('/x', controller.signal)
+    expect(listed.fs.resolveCalls[0]).toBe(controller.signal)
+
+    const read = await mount({ stat: FILE_INFO, readText: 'hello' })
+    await read.service.read('/x', controller.signal)
+    expect(read.fs.resolveCalls[0]).toBe(controller.signal)
+  })
+
+  it('returns entries without size or version when the backend omits them', async () => {
+    const entry: FsDirEntry = { name: 'plain', type: 'file', target: { targetKey: FsTargetKey('stub'), displayPath: '/stub/plain' } }
+    const { service } = await mount({ stat: DIR_INFO, listDir: [entry] })
+    const listing = await service.list('/x')
+    expect(listing.entries[0]).toMatchObject({ name: 'plain', type: 'file', hidden: false })
+    expect('size' in (listing.entries[0] ?? {})).toBe(false)
+    expect('version' in (listing.entries[0] ?? {})).toBe(false)
+  })
+
+  it('reports a read whose stat omits size using the decoded byte length', async () => {
+    const { service } = await mount({ stat: FILE_INFO, readText: 'hello' })
+    const file = await service.read('/x')
+    expect(file.size).toBe(5)
+    expect(file.content).toBe('hello')
+  })
+
+  it('answers an absent stat with files-not-found on list', async () => {
+    const { service } = await mount({ stat: undefined })
+    await expect(service.list('/x')).rejects.toMatchObject({ code: 'files-not-found' })
+  })
+
+  it('passes the expected version as a guarded write and the caller signal through resolve', async () => {
+    const controller = new AbortController()
+    const outcome: FsWriteOutcome = { operation: 'update', version: FsVersion('v2'), before: 'old', after: 'new' }
+    const { service, fs } = await mount({ stat: FILE_INFO, writeText: outcome })
+    const result = await service.write('/x', 'new', 'v1', controller.signal)
+    expect(result).toMatchObject({ path: '/stub', operation: 'update', version: 'v2', size: 3 })
+    expect(fs.resolveCalls[0]).toBe(controller.signal)
+  })
+
+  it('writes without a version guard when the caller observed none', async () => {
+    const outcome: FsWriteOutcome = { operation: 'create', version: FsVersion('v1'), before: null, after: 'x' }
+    const { service } = await mount({ stat: undefined, writeText: outcome })
+    const result = await service.write('/x', 'x', undefined)
+    expect(result).toMatchObject({ operation: 'create', version: 'v1', size: 1 })
+  })
+
+  it('refuses to write a directory target with files-not-file', async () => {
+    const { service } = await mount({ stat: DIR_INFO })
+    await expect(service.write('/x', 'x', undefined)).rejects.toMatchObject({ code: 'files-not-file' })
+  })
+})
