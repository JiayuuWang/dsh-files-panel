@@ -0,0 +1,84 @@
+/** Pure pane-tree operations: split, close, view/size updates. */
+
+import { describe, expect, it } from 'vitest'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import {
+  closePane, findLeaf, initialPane, isSingle, parentSplit, setLeafView, setSplitSizes, splitPane,
+} from '../src/client/pane-tree.ts'
+import type { PaneNode } from '../src/client/contract/panes.ts'
+
+const sid = (id: string): SessionId => id as SessionId
+
+describe('initialPane', () => {
+  it('is a single chat leaf bound to its session', () => {
+    expect(initialPane(sid('s1'))).toEqual({ kind: 'leaf', paneId: 'pane-1', viewId: 'chat', sessionId: 's1' })
+  })
+})
+
+describe('splitPane', () => {
+  it('splits a leaf into an even two-child split', () => {
+    const root = splitPane(initialPane(sid('s1')), 'pane-1', 'pane-2', 'split-1', 'row', 'terminal', sid('s2'))
+    expect(root).toEqual({
+      kind: 'split', splitId: 'split-1', direction: 'row',
+      children: [
+        { kind: 'leaf', paneId: 'pane-1', viewId: 'chat', sessionId: 's1' },
+        { kind: 'leaf', paneId: 'pane-2', viewId: 'terminal', sessionId: 's2' },
+      ],
+      sizes: [0.5, 0.5],
+    })
+    expect(findLeaf(root, 'pane-2')?.viewId).toBe('terminal')
+  })
+
+  it('splits a nested leaf recursively', () => {
+    const once = splitPane(initialPane(sid('s1')), 'pane-1', 'pane-2', 's1', 'row', 'trajectory', sid('s1'))
+    const twice = splitPane(once, 'pane-2', 'pane-3', 's2', 'column', 'terminal', sid('s1'))
+    const split = twice as { kind: 'split'; children: PaneNode[] }
+    expect(split.children[1]).toMatchObject({ kind: 'split', splitId: 's2', direction: 'column' })
+    expect(findLeaf(twice, 'pane-3')?.viewId).toBe('terminal')
+  })
+})
+
+describe('closePane', () => {
+  it('collapses a split back to its sibling leaf', () => {
+    const split = splitPane(initialPane(sid('s1')), 'pane-1', 'pane-2', 's1', 'row', 'terminal', sid('s2'))
+    expect(closePane(split, 'pane-2')).toEqual({ kind: 'leaf', paneId: 'pane-1', viewId: 'chat', sessionId: 's1' })
+    expect(closePane(split, 'pane-1')).toEqual({ kind: 'leaf', paneId: 'pane-2', viewId: 'terminal', sessionId: 's2' })
+  })
+
+  it('re-normalizes sizes when one of three children closes', () => {
+    const three: PaneNode = {
+      kind: 'split', splitId: 's3', direction: 'row',
+      children: [
+        { kind: 'leaf', paneId: 'a', viewId: 'chat', sessionId: sid('s1') },
+        { kind: 'leaf', paneId: 'b', viewId: 'trajectory', sessionId: sid('s2') },
+        { kind: 'leaf', paneId: 'c', viewId: 'terminal', sessionId: sid('s3') },
+      ],
+      sizes: [0.5, 0.3, 0.2],
+    }
+    const closed = closePane(three, 'b') as { kind: 'split'; sizes: number[] }
+    expect(closed.sizes).toHaveLength(2)
+    expect(closed.sizes.reduce((sum, value) => sum + value, 0)).toBeCloseTo(1)
+    expect(closed.sizes[0]).toBeCloseTo(0.5 / 0.7)
+  })
+})
+
+describe('setLeafView and setSplitSizes', () => {
+  it('changes a leaf view and normalizes split sizes', () => {
+    const split = splitPane(initialPane(sid('s1')), 'pane-1', 'pane-2', 's1', 'row', 'trajectory', sid('s1'))
+    const viewed = setLeafView(split, 'pane-1', 'terminal')
+    expect(findLeaf(viewed, 'pane-1')?.viewId).toBe('terminal')
+    const sized = setSplitSizes(split, 's1', [0.7, 0.3])
+    expect((sized as { kind: 'split'; sizes: number[] }).sizes).toEqual([0.7, 0.3])
+  })
+})
+
+describe('isSingle and parentSplit', () => {
+  it('reports singletons and locates the containing split', () => {
+    expect(isSingle(initialPane(sid('s1')))).toBe(true)
+    const split = splitPane(initialPane(sid('s1')), 'pane-1', 'pane-2', 's1', 'row', 'trajectory', sid('s1'))
+    expect(isSingle(split)).toBe(false)
+    expect(parentSplit(split, 'pane-2')).toMatchObject({ splitId: 's1' })
+    expect(parentSplit(split, 'pane-1')).toMatchObject({ splitId: 's1' })
+    expect(parentSplit(initialPane(sid('s1')), 'pane-1')).toBeUndefined()
+  })
+})
diff --git a/packages/client/ui-conversation/tests/pane-tree.client.spec.tsx b/packages/client/ui-conversation/tests/pane-tree.client.spec.tsx
