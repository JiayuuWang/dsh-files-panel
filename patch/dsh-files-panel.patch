+
+    // Split into two leaves, both on s1.
+    store.actions.splitPane('pane-1', 'row', sid('s1'))
+    expect(store.getSnapshot().panes).toMatchObject({ kind: 'split' })
+
+    // Focusing s1 finds the existing bound leaf.
+    store.actions.focusSession(sid('s1'))
+    expect(store.getSnapshot().focusedPaneId).not.toBeNull()
+
+    // A session not in the tree re-homes the focused leaf onto it (fresh chat).
+    store.actions.focusSession(sid('s2'))
+    const split = store.getSnapshot().panes as PaneSplit
+    expect(split.children.some(child => child.kind === 'leaf' && child.sessionId === 's2' && child.viewId === 'chat')).toBe(true)
+  })
+
+  it('splitPane inherits the source view and binds the new session', () => {
+    const store = createPaneStore().create()
+    store.actions.init(sid('s1'))
+    store.actions.splitPane('pane-1', 'column', sid('s2'))
+    const split = store.getSnapshot().panes as PaneSplit
+    const second = split.children[1] as PaneLeaf
+    expect(second).toMatchObject({ viewId: 'chat', sessionId: 's2' })
+    expect(store.getSnapshot().focusedPaneId).toBe(second.paneId)
+  })
+
+  it('splitPane of a terminal pane mints a fresh terminal key', () => {
+    const store = createPaneStore().create()
+    store.actions.init(sid('s1'))
+    store.actions.setPaneView('pane-1', 'terminal')
+    const firstTerminalId = (store.getSnapshot().panes as PaneLeaf).terminalId
+    store.actions.splitPane('pane-1', 'row', sid('s1'))
+    const split = store.getSnapshot().panes as PaneSplit
+    const second = split.children[1] as PaneLeaf
+    expect(second.viewId).toBe('terminal')
+    expect(second.terminalId).toBeDefined()
+    expect(second.terminalId).not.toBe(firstTerminalId)
+  })
+
+  it('setPaneView mints a terminal key once and reuses it', () => {
+    const store = createPaneStore().create()
+    store.actions.init(sid('s1'))
+    store.actions.setPaneView('pane-1', 'terminal')
+    const first = (store.getSnapshot().panes as PaneLeaf).terminalId
+    store.actions.setPaneView('pane-1', 'chat')
+    store.actions.setPaneView('pane-1', 'terminal')
+    const second = (store.getSnapshot().panes as PaneLeaf).terminalId
+    expect(second).toBe(first)
+  })
+
+  it('closePane collapses a split and clears focus/fullscreen', () => {
+    const store = createPaneStore().create()
+    store.actions.init(sid('s1'))
+    store.actions.splitPane('pane-1', 'row', sid('s2'))
+    const newPaneId = ((store.getSnapshot().panes as PaneSplit).children[1] as PaneLeaf).paneId
+    store.actions.toggleFullscreen(newPaneId)
+    store.actions.closePane(newPaneId)
+    expect(store.getSnapshot().panes).toMatchObject({ kind: 'leaf' })
+    expect(store.getSnapshot().fullscreenPaneId).toBeNull()
+  })
+
+  it('switchFocusedTo and setPaneSizes and toggleFullscreen drive their slices', () => {
+    const store = createPaneStore().create()
+    store.actions.init(sid('s1'))
+    store.actions.splitPane('pane-1', 'row', sid('s2'))
+    const split = store.getSnapshot().panes as PaneSplit
+    store.actions.setPaneSizes(split.splitId, [0.7, 0.3])
+    expect((store.getSnapshot().panes as PaneSplit).sizes).toEqual([0.7, 0.3])
+    // The fresh pane is focused; switchFocusedTo moves IT, not the source leaf.
+    const focusedPane = (store.getSnapshot().panes as PaneSplit).children[1] as PaneLeaf
+    store.actions.switchFocusedTo('trajectory')
+    expect(findLeaf(store.getSnapshot().panes!, focusedPane.paneId)?.viewId).toBe('trajectory')
+    store.actions.toggleFullscreen(focusedPane.paneId)
+    expect(store.getSnapshot().fullscreenPaneId).toBe(focusedPane.paneId)
+    store.actions.toggleFullscreen(focusedPane.paneId)
+    expect(store.getSnapshot().fullscreenPaneId).toBeNull()
+  })
+
+  it('persists as a single root key (unsuffixed)', () => {
+    const store = createPaneStore().create()
+    store.actions.init(sid('s1'))
+    expect(localStorage.getItem(PERSIST)).not.toBeNull()
+    const again = createPaneStore().create()
+    expect(again.getSnapshot().panes).toMatchObject({ sessionId: 's1' })
+  })
+})
diff --git a/packages/client/ui-conversation/tests/pane-tree.client.spec.ts b/packages/client/ui-conversation/tests/pane-tree.client.spec.ts
