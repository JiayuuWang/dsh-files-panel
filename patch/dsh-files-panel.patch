+++ b/packages/host/apiproxy/tests/api-proxy-terminal.spec.ts
@@ -0,0 +1,245 @@
+/** Wire behavior of the terminal domain over a scripted web-terminal service. */
+
+import { afterAll, beforeAll, beforeEach, describe, expect, it } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import AgentRegistry, { Inbox } from '@deepseek-ai/dsh-agent'
+import type { Agent, AgentFactory } from '@deepseek-ai/dsh-agent'
+import SessionStore from '@deepseek-ai/dsh-session'
+import type { Session } from '@deepseek-ai/dsh-session'
+import Storage from '@deepseek-ai/dsh-storage'
+import { DomainFacility } from '@deepseek-ai/dsh-storage-domain'
+import UserQuestionService from '@deepseek-ai/dsh-user-questions'
+import { createApiProxy } from '@deepseek-ai/dsh-host-apiproxy'
+import type { ApiProxy } from '@deepseek-ai/dsh-host-apiproxy/api'
+import type { RpcRequest } from '@deepseek-ai/dsh-host-apiproxy/api/rpc'
+import { RpcId } from '@deepseek-ai/dsh-host-apiproxy/api/rpc'
+import { MemoryStorageBackend } from '../../../storage/storage-domain/tests/helpers/memory-backend.ts'
+
+class FakeTerminalSession {
+  readonly pid = 7
+  readonly cols = 120
+  readonly rows = 40
+  output = ''
+  writes: string[] = []
+  signals: string[] = []
+  closed = false
+  writeError = false
+
+  constructor(readonly id: string, readonly terminalId: string) {}
+
+  read(cursor: number): { output: string; cursor: number; truncated: boolean; exited: boolean } {
+    return { output: this.output.slice(cursor), cursor: this.output.length, truncated: false, exited: false }
+  }
+
+  async write(data: string): Promise<void> {
+    if (this.writeError) throw new Error('terminal has exited')
+    this.writes.push(data)
+  }
+
+  async signal(signal: string): Promise<void> {
+    this.signals.push(signal)
+  }
+
+  async close(): Promise<void> {
+    this.closed = true
+  }
+}
+
+function stubAgent(session: Session): Agent {
+  const inbox = new Inbox(session, { inserted: () => {}, discarded: () => {}, claimed: () => {} })
+  return {
+    id: session.id,
+    options: {},
+    session,
+    inbox,
+    status: 'idle',
+    ctx: new Context(),
+    send: () => {},
+    followup: () => {},
+    steer: () => ({ outcome: Promise.resolve({ status: 'rejected' as const }) }),
+    inject: message => { inbox.append('next-step', message) },
+    cancel() {},
+    runMaintenance: job => job(new AbortController().signal),
+    whenIdle: () => Promise.resolve(),
+  }
+}
+
+let ctx: Context
+let api: ApiProxy
+let dispose: () => Promise<void>
+const sessions = new Map<string, FakeTerminalSession>()
+let openError: string | undefined
+
+function keyOf(sessionId: string, terminalId: string): string {
+  return `${sessionId}\u0000${terminalId}`
+}
+
+beforeAll(async () => {
+  ctx = new Context()
+  await ctx.plugin(SessionStore)
+  await ctx.plugin(AgentRegistry)
+  await ctx.plugin(UserQuestionService)
+  await ctx.plugin(Storage)
+  ctx.storage.backend.register('memory', new MemoryStorageBackend())
+  const storageDomain = new DomainFacility(ctx, { backend: 'memory', routes: {} })
+  ctx.storage.mount('domain', storageDomain)
+  ctx.provide('storageDomain', storageDomain)
+  ctx.provide('sessionPersistence', { list: () => Promise.resolve([]) } as never)
+
+  const factory: AgentFactory = {
+    async createAgent(_ownerCtx, options) {
+      const session = ctx.sessions.create(options.sessionId, options.meta === undefined ? {} : { meta: options.meta })
+      const agent = stubAgent(session)
+      const unregister = ctx.agents.register(agent)
+      return { agent, dispose: () => { unregister(); return Promise.resolve() } }
+    },
+    async resume() {
+      throw new Error('test harness has no persisted sessions')
+    },
+  }
+  ctx.agents.setFactory(factory)
+
+  ctx.provide('webTerminals', {
+    async open(sessionId: string, terminalId: string) {
+      if (openError !== undefined) throw new Error(openError)
+      const key = keyOf(sessionId, terminalId)
+      const existing = sessions.get(key)
+      if (existing !== undefined) return existing
+      const created = new FakeTerminalSession(sessionId, terminalId)
+      sessions.set(key, created)
+      return created
+    },
+    get(sessionId: string, terminalId: string) {
+      return sessions.get(keyOf(sessionId, terminalId))
+    },
+    shells() {
+      return ['pwsh', 'cmd']
+    },
+    async disposeSession(sessionId: string) {
+      for (const [key, session] of sessions) {
+        if (session.id === sessionId) {
+          await session.close()
+          sessions.delete(key)
+        }
+      }
+    },
+  } as never)
+
+  api = createApiProxy(ctx, { defaultModelSelection: () => ({ provider: 'test', model: 'test-model' }), cwd: '/tmp' })
+  dispose = async () => {}
+})
+
+afterAll(async () => {
+  await dispose()
+})
+
+beforeEach(() => {
+  sessions.clear()
+  openError = undefined
+})
+
+let nextRpc = 1
+
+function request<P>(payload: P): RpcRequest<P> {
+  return { rpcId: RpcId(`terminal-${String(nextRpc++)}`), payload }
+}
+
+async function openSession(): Promise<string> {
+  const response = await api.sessions.create(request({ cwd: '/tmp' }))
+  if (!response.result.ok) throw new Error('unreachable')
+  return response.result.value.sessionId
+}
+
+const TID = 'pane-term'
+
+describe('terminal.open', () => {
+  it('opens and re-attaches one terminal per (session, terminalId), echoing the rpcId', async () => {
+    const sessionId = await openSession()
+    const rpc = request({ sessionId: sessionId as never, terminalId: TID })
+    const response = await api.terminal.open(rpc, new AbortController().signal)
+    expect(response.rpcId).toBe(rpc.rpcId)
+    if (!response.result.ok) throw new Error('unreachable')
+    expect(response.result.value).toMatchObject({ pid: 7, cols: 120, rows: 40, output: '', cursor: 0 })
+    const again = await api.terminal.open(request({ sessionId: sessionId as never, terminalId: TID }), new AbortController().signal)
+    if (!again.result.ok) throw new Error('unreachable')
+    expect(sessions.size).toBe(1)
+  })
+
+  it('opens a distinct terminal for a distinct terminalId of the same session', async () => {
+    const sessionId = await openSession()
+    await api.terminal.open(request({ sessionId: sessionId as never, terminalId: 'a' }), new AbortController().signal)
+    await api.terminal.open(request({ sessionId: sessionId as never, terminalId: 'b' }), new AbortController().signal)
+    expect(sessions.size).toBe(2)
+  })
+
+  it('answers terminal-not-found when no terminal is open', async () => {
+    const response = await api.terminal.read(request({ sessionId: 'no-session' as never, terminalId: TID, cursor: 0 }), new AbortController().signal)
+    expect(response.result).toMatchObject({ ok: false, error: { code: 'terminal-not-found' } })
+  })
+})
+
+describe('terminal error mapping', () => {
+  it('answers session-not-found when opening an unknown session', async () => {
+    const response = await api.terminal.open(request({ sessionId: 'no-such' as never, terminalId: TID }), new AbortController().signal)
+    expect(response.result).toMatchObject({ ok: false, error: { code: 'session-not-found' } })
+  })
+
+  it('maps a spawn failure to terminal-spawn-failed', async () => {
+    const sessionId = await openSession()
+    openError = 'boom'
+    try {
+      const response = await api.terminal.open(request({ sessionId: sessionId as never, terminalId: TID }), new AbortController().signal)
+      expect(response.result).toMatchObject({ ok: false, error: { code: 'terminal-spawn-failed', message: 'boom' } })
+    } finally {
+      openError = undefined
+    }
+  })
+
+  it('maps a write on an exited terminal to terminal-exited', async () => {
+    const sessionId = await openSession()
+    await api.terminal.open(request({ sessionId: sessionId as never, terminalId: TID }), new AbortController().signal)
+    sessions.get(keyOf(sessionId, TID))!.writeError = true
+    const response = await api.terminal.write(request({ sessionId: sessionId as never, terminalId: TID, data: 'x' }), new AbortController().signal)
+    expect(response.result).toMatchObject({ ok: false, error: { code: 'terminal-exited' } })
+  })
+
+  it('maps an aborted caller to cancelled when the write fails', async () => {
+    const sessionId = await openSession()
+    await api.terminal.open(request({ sessionId: sessionId as never, terminalId: TID }), new AbortController().signal)
+    sessions.get(keyOf(sessionId, TID))!.writeError = true
