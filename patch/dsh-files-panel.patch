+/** Files-tab slot registration and its plain files.* wire callbacks. */
+import { Context } from '@deepseek-ai/cordis'
+import { describe, expect, it, vi } from 'vitest'
+import { SlotRegistry } from '@deepseek-ai/dsh-client-runtime/client'
+import { LocaleRuntime } from '@deepseek-ai/dsh-client-locale/client'
+import { apply, inject } from '@deepseek-ai/dsh-client-ui-files/client'
+import type { FilesInjected } from '@deepseek-ai/dsh-client-ui-files/client'
+import { apply as hostApply } from '../src/index.ts'
+
+async function bench(declare = true) {
+  const ctx = new Context()
+  await ctx.plugin(SlotRegistry).await()
+  const connection = { api: { files: { list: vi.fn(), read: vi.fn(), write: vi.fn() } } }
+  ctx.provide('connection', connection)
+  ctx.provide('locale', new LocaleRuntime(ctx))
+  const slots = ctx.get('slots') as SlotRegistry
+  if (declare) {
+    slots.register(
+      { name: 'root', children: { 'conversation.details.files': { kind: 'single', scope: 'session' } } } as never,
+      () => null,
+    )
+  }
+  return { ctx, slots, connection }
+}
+
+describe('ui-files apply', () => {
+  it('declares only the services it uses', () => {
+    expect(inject).toEqual(['slots', 'connection', 'locale'])
+  })
+
+  it('provides no host-side behavior on the node half', () => {
+    expect(hostApply()).toBeUndefined()
+  })
+
+  it('registers the panel and injects the files.* wire calls', async () => {
+    const b = await bench()
+    await b.ctx.plugin({ inject: [...inject], apply }).await()
+    expect(b.slots.entries('conversation.details.files')).toHaveLength(1)
+    const injected = (b.slots.entries('conversation.details.files')[0]!.inject as unknown as () => FilesInjected)()
+    expect(Object.keys(injected)).toEqual(['listDirectory', 'readFile', 'writeFile'])
+    const signal = new AbortController().signal
+    void injected.listDirectory('/x', signal)
+    expect(b.connection.api.files.list).toHaveBeenCalledWith({ path: '/x' }, signal)
+    void injected.readFile('/x')
+    expect(b.connection.api.files.read).toHaveBeenCalledWith({ path: '/x' }, undefined)
+    void injected.writeFile({ sessionId: 's1' as never, path: '/x', content: 'c', expectedVersion: 'v' })
+    expect(b.connection.api.files.write).toHaveBeenCalledWith({
+      sessionId: 's1', path: '/x', content: 'c', expectedVersion: 'v',
+    }, undefined)
+  })
+
+  it('installs once a later declaration appears', async () => {
+    const b = await bench(false)
+    const fiber = b.ctx.plugin({ inject: [...inject], apply })
+    await fiber.await()
+    // slots.inject waits on the declaration rather than failing: nothing yet.
+    expect(b.slots.entries('conversation.details.files')).toHaveLength(0)
+    b.slots.register(
+      { name: 'root', children: { 'conversation.details.files': { kind: 'single', scope: 'session' } } } as never,
+      () => null,
+    )
+    await vi.waitFor(() => expect(b.slots.entries('conversation.details.files')).toHaveLength(1))
+    await fiber.dispose()
+    expect(b.slots.entries('conversation.details.files')).toHaveLength(0)
+  })
+
+  it('removes the entry on teardown', async () => {
+    const b = await bench()
+    const fiber = b.ctx.plugin({ inject: [...inject], apply })
+    await fiber.await()
+    await fiber.dispose()
+    expect(b.slots.entries('conversation.details.files')).toHaveLength(0)
+  })
+})
