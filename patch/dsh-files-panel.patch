+// @vitest-environment jsdom
+/** TerminalView: opens/reattaches a per-session PTY, polls output, forwards keystrokes, restarts. */
+
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { cleanup, fireEvent, render, screen } from '@testing-library/react'
+import type { RpcResponse } from '@deepseek-ai/dsh-api-remotes/client'
+import type { TerminalViewProps } from '../src/client/contract.ts'
+import { TerminalView } from '../src/client/TerminalView.tsx'
+
+vi.mock('@xterm/xterm/css/xterm.css', () => ({}))
+
+interface MockTerminalInstance {
+  readonly options: { cols: number; rows: number; convertEol: boolean }
+  host: HTMLElement | undefined
+  written: string[]
+  onDataCb: ((data: string) => void) | undefined
+  disposed: boolean
+}
+
+type MockTerminalStatic = {
+  instances: MockTerminalInstance[]
+  new (options: { cols: number; rows: number; convertEol: boolean }): MockTerminalInstance
+}
+
+vi.mock('@xterm/xterm', () => {
+  class MockTerminal {
+    static readonly instances: MockTerminalInstance[] = []
+    host: HTMLElement | undefined
+    readonly written: string[] = []
+    onDataCb: ((data: string) => void) | undefined
+    disposed = false
+    constructor(readonly options: { cols: number; rows: number; convertEol: boolean }) {
+      MockTerminal.instances.push(this)
+    }
+    open(host: HTMLElement): void { this.host = host }
+    write(data: string): void { this.written.push(data) }
+    onData(cb: (data: string) => void): void { this.onDataCb = cb }
+    dispose(): void {
+      this.disposed = true
+      const index = MockTerminal.instances.indexOf(this)
+      if (index >= 0) MockTerminal.instances.splice(index, 1)
+    }
+  }
+  return { Terminal: MockTerminal }
+})
+
+const MockTerminal = (await import('@xterm/xterm')).Terminal as unknown as MockTerminalStatic
+
+const ok = <T,>(value: T): Promise<RpcResponse<T>> =>
+  Promise.resolve({ rpcId: 'r' as never, result: { ok: true, value } })
+
+let opens: ReturnType<typeof vi.fn>
+let writes: ReturnType<typeof vi.fn>
+let reads: ReturnType<typeof vi.fn>
+let closes: ReturnType<typeof vi.fn>
+let shells: ReturnType<typeof vi.fn>
+
+function props(overrides: Partial<TerminalViewProps> = {}): TerminalViewProps {
+  return {
+    sessionId: 's1' as never,
+    useSessions: (selector) => selector({ byId: { s1: { cwd: '/work' } } } as never),
+    openTerminal: opens,
+    writeTerminal: writes,
+    readTerminal: reads,
+    signalTerminal: vi.fn(),
+    closeTerminal: closes,
+    listTerminalShells: shells,
+    t: (key) => key,
+    ...overrides,
+  } as TerminalViewProps
+}
+
+beforeEach(() => {
+  opens = vi.fn((_payload) => ok({ pid: 7, cols: 120, rows: 40, output: 'prompt> ', cursor: 8 }))
+  writes = vi.fn((_payload) => ok({ delivered: true as const }))
+  reads = vi.fn((payload: { cursor: number }) => ok({ output: '', cursor: payload.cursor, truncated: false, exited: false }))
+  closes = vi.fn((_payload) => ok({ closed: true as const }))
+  shells = vi.fn((_payload) => ok({ shells: ['pwsh', 'cmd'] }))
+})
+
+afterEach(() => {
+  cleanup()
+  MockTerminal.instances.length = 0
+})
+
+describe('TerminalView', () => {
+  it('opens the session terminal, seeds the emulator, and forwards keystrokes', async () => {
+    render(<TerminalView {...props()} />)
+    await vi.waitFor(() => expect(MockTerminal.instances).toHaveLength(1))
+    expect(opens).toHaveBeenCalledWith({ sessionId: 's1', terminalId: 's1', cwd: '/work' }, expect.any(AbortSignal))
+    const term = MockTerminal.instances[0]!
+    expect(term.options).toMatchObject({ cols: 120, rows: 40 })
+    expect(term.written).toContain('prompt> ')
+    expect(term.host).toBeInstanceOf(HTMLElement)
+    term.onDataCb?.('ls\r')
+    expect(writes).toHaveBeenCalledWith({ sessionId: 's1', terminalId: 's1', data: 'ls\r' })
+  })
+
+  it('keys the terminal by the pane terminalId when one is supplied', async () => {
+    render(<TerminalView {...props({ terminalId: 'pane-term' })} />)
+    await vi.waitFor(() => expect(MockTerminal.instances).toHaveLength(1))
+    expect(opens).toHaveBeenCalledWith({ sessionId: 's1', terminalId: 'pane-term', cwd: '/work' }, expect.any(AbortSignal))
+  })
+
+  it('polls terminal.read and writes deltas into the emulator', async () => {
+    reads.mockResolvedValueOnce(ok({ output: 'hello', cursor: 13, truncated: false, exited: false }))
+    render(<TerminalView {...props()} />)
+    await vi.waitFor(() => expect(MockTerminal.instances).toHaveLength(1))
+    await vi.waitFor(() => expect(MockTerminal.instances[0]!.written).toContain('hello'))
+  })
+
+  it('renders the unavailable banner when the seam is absent', async () => {
+    opens.mockResolvedValueOnce({ rpcId: 'r' as never, result: { ok: false, error: { code: 'terminal-unavailable', message: 'nope', details: { sessionId: 's1' } } } })
+    render(<TerminalView {...props()} />)
+    await vi.waitFor(() => expect(screen.getByText('unavailable')).toBeTruthy())
+    expect(MockTerminal.instances).toHaveLength(0)
+  })
+
+  it('stops polling and shows the exited banner once the shell exits', async () => {
+    reads.mockResolvedValueOnce(ok({ output: '', cursor: 8, truncated: false, exited: true }))
+    render(<TerminalView {...props()} />)
+    await vi.waitFor(() => expect(MockTerminal.instances).toHaveLength(1))
+    await vi.waitFor(() => expect(screen.getByText('exited')).toBeTruthy())
+  })
+
+  it('restarts by closing then reopening a fresh terminal', async () => {
+    render(<TerminalView {...props()} />)
+    await vi.waitFor(() => expect(MockTerminal.instances).toHaveLength(1))
+    const first = MockTerminal.instances[0]!
+    fireEvent.click(screen.getByRole('button', { name: 'restart' }))
+    await vi.waitFor(() => expect(closes).toHaveBeenCalled())
+    await vi.waitFor(() => expect(MockTerminal.instances).toHaveLength(1))
+    expect(first.disposed).toBe(true)
+    expect(opens).toHaveBeenCalledTimes(2)
+  })
+
+  it('disposes the emulator on unmount without closing the host terminal', () => {
+    const view = render(<TerminalView {...props()} />)
+    view.unmount()
+    expect(MockTerminal.instances).toHaveLength(0)
+    expect(closes).not.toHaveBeenCalled()
+  })
+
+  it('shows a shell segmented picker and reopens with the chosen shell', async () => {
+    render(<TerminalView {...props()} />)
+    await vi.waitFor(() => expect(screen.getByRole('button', { name: 'shell.default' })).toBeTruthy())
+    expect(opens).toHaveBeenCalledWith({ sessionId: 's1', terminalId: 's1', cwd: '/work' }, expect.any(AbortSignal))
+    fireEvent.click(screen.getByRole('button', { name: 'cmd' }))
+    await vi.waitFor(() => expect(closes).toHaveBeenCalledWith({ sessionId: 's1', terminalId: 's1' }))
+    await vi.waitFor(() => expect(opens).toHaveBeenCalledTimes(2))
+    expect(opens).toHaveBeenLastCalledWith({ sessionId: 's1', terminalId: 's1', cwd: '/work', shell: 'cmd' }, expect.any(AbortSignal))
+  })
+
+  it('reopens with the platform default when the default segment is clicked', async () => {
+    render(<TerminalView {...props()} />)
+    await vi.waitFor(() => expect(screen.getByRole('button', { name: 'cmd' })).toBeTruthy())
+    fireEvent.click(screen.getByRole('button', { name: 'cmd' }))
+    await vi.waitFor(() => expect(opens).toHaveBeenCalledTimes(2))
+    fireEvent.click(screen.getByRole('button', { name: 'shell.default' }))
+    await vi.waitFor(() => expect(opens).toHaveBeenCalledTimes(3))
+    // The default segment sends no shell field: the platform default applies.
+    expect(opens).toHaveBeenLastCalledWith({ sessionId: 's1', terminalId: 's1', cwd: '/work' }, expect.any(AbortSignal))
+  })
+
+  it('renders no shell picker when the host reports no shells', async () => {
+    shells.mockResolvedValueOnce(ok({ shells: [] }))
+    render(<TerminalView {...props()} />)
+    await vi.waitFor(() => expect(MockTerminal.instances).toHaveLength(1))
+    expect(screen.queryByText('shell.label')).toBeNull()
+  })
+})
