+/** Platform shell selection of the web-terminal backend. */
+
+import { describe, expect, it } from 'vitest'
+import { availableShells, shellArgv } from '../src/resolve.ts'
+
+describe('shellArgv', () => {
+  it('selects pwsh with -NoLogo -NoProfile on Windows', () => {
+    expect(shellArgv('win32', '/bin/bash', 'C:\\pwsh.exe')).toEqual({
+      argv: ['C:\\pwsh.exe', '-NoLogo', '-NoProfile'],
+    })
+  })
+
+  it('selects bash with --noprofile --norc -i elsewhere', () => {
+    expect(shellArgv('linux', '/bin/bash')).toEqual({
+      argv: ['/bin/bash', '--noprofile', '--norc', '-i'],
+    })
+  })
+
+  it('honors the configured non-Windows shell path', () => {
+    expect(shellArgv('darwin', '/opt/zsh')).toEqual({
+      argv: ['/opt/zsh', '--noprofile', '--norc', '-i'],
+    })
+  })
+
+  it('spawns cmd on Windows when cmd is named', () => {
+    expect(shellArgv('win32', '/bin/bash', 'C:\\pwsh.exe', 'cmd')).toEqual({ argv: ['cmd.exe'] })
+  })
+
+  it('spawns zsh and sh on POSIX when named', () => {
+    expect(shellArgv('linux', '/bin/bash', undefined, 'zsh')).toEqual({ argv: ['zsh', '-i'] })
