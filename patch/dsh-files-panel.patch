diff --git a/packages/host/web-terminal-local/tests/service.spec.ts b/packages/host/web-terminal-local/tests/service.spec.ts
new file mode 100644
index 0000000000..384b7988bd
--- /dev/null
+++ b/packages/host/web-terminal-local/tests/service.spec.ts
@@ -0,0 +1,180 @@
+/** Behavior of the subprocess-backed web-terminal service over a scripted terminal handle. */
+
+import { PassThrough } from 'node:stream'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import type {
+  SubprocessOutcome,
+  SubprocessTerminalForeground,
+  SubprocessTerminalHandle,
+  SubprocessTerminalSignal,
+  SubprocessTerminalSpawnSpec,
+} from '@deepseek-ai/dsh-subprocess'
+import LocalWebTerminalService from '../src/index.ts'
+import { shellArgv } from '../src/resolve.ts'
+
+const sid = (id: string): SessionId => id as SessionId
+
+class FakeTerminal implements SubprocessTerminalHandle {
+  readonly pid = 100
+  readonly output = new PassThrough()
+  readonly done: Promise<SubprocessOutcome>
+  readonly writes: string[] = []
+  readonly signals: string[] = []
+  terminated = false
+  private readonly doneResolver = Promise.withResolvers<SubprocessOutcome>()
+
+  constructor(readonly spec: SubprocessTerminalSpawnSpec) {
+    this.done = this.doneResolver.promise
+  }
+
+  async write(data: string): Promise<void> {
+    this.writes.push(data)
+  }
+
+  async inspectForeground(): Promise<SubprocessTerminalForeground | undefined> {
+    return undefined
+  }
+
+  async signalForeground(signal: SubprocessTerminalSignal): Promise<number> {
+    this.signals.push(signal)
+    return 1
+  }
+
+  async terminate(): Promise<void> {
+    this.terminated = true
+    this.output.end()
+    this.doneResolver.resolve({ exitCode: 0, signal: null })
+  }
+}
+
+let ctx: Context
+let spawnTerminal: ReturnType<typeof vi.fn>
+let dispose: () => Promise<void>
+
+async function setup(config: Record<string, unknown> = {}): Promise<void> {
+  ctx = new Context()
+  spawnTerminal = vi.fn((spec: SubprocessTerminalSpawnSpec) => new FakeTerminal(spec))
+  ctx.provide('subprocess', { spawnTerminal } as never)
+  const fiber = ctx.plugin(LocalWebTerminalService, config as never)
+  await fiber.await()
+  dispose = async () => { await fiber.dispose() }
+}
+
+function service(): LocalWebTerminalService {
+  return ctx.get('webTerminals') as LocalWebTerminalService
+}
+
+function fakeTerminal(): FakeTerminal {
+  return spawnTerminal.mock.results[0]?.value as FakeTerminal
+}
+
+afterEach(async () => {
+  await dispose()
+  vi.clearAllMocks()
+})
+
+describe('LocalWebTerminalService.open', () => {
+  it('spawns one terminal per (session, terminalId) and reuses it on re-open', async () => {
+    await setup()
+    const first = await service().open(sid('s1'), 't1', '/work')
+    const second = await service().open(sid('s1'), 't1', '/other')
+    expect(second).toBe(first)
+    expect(first.pid).toBe(100)
+    expect(first.cols).toBe(120)
+    expect(first.rows).toBe(40)
+    expect(spawnTerminal).toHaveBeenCalledTimes(1)
+    expect(service().get(sid('s1'), 't1')).toBe(first)
+    expect(service().get(sid('s1'), 't2')).toBeUndefined()
+    expect(service().get(sid('s2'), 't1')).toBeUndefined()
+  })
+
+  it('spawns a distinct terminal for a distinct terminalId of the same session', async () => {
+    await setup()
+    const first = await service().open(sid('s1'), 't1')
+    const second = await service().open(sid('s1'), 't2')
+    expect(second).not.toBe(first)
+    expect(spawnTerminal).toHaveBeenCalledTimes(2)
+  })
+
+  it('defaults the working directory to the process cwd and forwards it', async () => {
+    await setup()
+    await service().open(sid('s1'), 't1')
+    expect(fakeTerminal().spec.cwd).toBe(process.cwd())
+    expect(fakeTerminal().spec.argv[0]).toBe(shellArgv(process.platform, '/bin/bash', undefined).argv[0])
+  })
+
+  it('spawns the explicit shell when one is named', async () => {
+    await setup()
+    await service().open(sid('s1'), 't1', undefined, process.platform === 'win32' ? 'cmd' : 'sh')
+    const name = process.platform === 'win32' ? 'cmd.exe' : 'sh'
+    expect(fakeTerminal().spec.argv[0]).toBe(name)
+  })
+
+  it('lists the platform shells', async () => {
+    await setup()
+    const shells = service().shells()
+    if (process.platform === 'win32') expect(shells).toEqual(['pwsh', 'cmd'])
+    else expect(shells).toEqual(['bash', 'zsh', 'sh'])
+  })
+
+  it('disposes every terminal of a session', async () => {
+    await setup()
+    await service().open(sid('s1'), 't1')
+    await service().open(sid('s1'), 't2')
+    await service().open(sid('s2'), 't1')
+    await service().disposeSession(sid('s1'))
+    expect(service().get(sid('s1'), 't1')).toBeUndefined()
+    expect(service().get(sid('s1'), 't2')).toBeUndefined()
+    expect(service().get(sid('s2'), 't1')).toBeDefined()
+  })
+})
+
+describe('LocalWebTerminalSession', () => {
+  it('reads output by cursor and reports exit', async () => {
+    await setup()
+    const session = await service().open(sid('s1'), 't1')
+    const fake = fakeTerminal()
+    fake.output.write('hello ')
+    fake.output.write('world')
+    expect(session.read(0)).toEqual({ output: 'hello world', cursor: 11, truncated: false, exited: false })
+    expect(session.read(11)).toEqual({ output: '', cursor: 11, truncated: false, exited: false })
+    fake.output.write('!')
+    expect(session.read(11)).toEqual({ output: '!', cursor: 12, truncated: false, exited: false })
+    await fake.terminate()
+    expect(session.read(0).exited).toBe(true)
+  })
+
+  it('rejects an invalid read cursor', async () => {
+    await setup()
+    const session = await service().open(sid('s1'), 't1')
+    expect(() => session.read(-1)).toThrow('cursor')
+  })
+
+  it('flags truncation when output exceeds the scrollback bound', async () => {
+    await setup({ scrollbackMaxBytes: 8 })
+    const session = await service().open(sid('s1'), 't1')
+    fakeTerminal().output.write('hello world')
+    // 11 bytes overflow the 8-byte bound: the head is evicted and read(0) truncates.
+    expect(session.read(0).truncated).toBe(true)
+    expect(session.read(0).output).toBe('lo world')
+  })
+
+  it('forwards writes and signals to the terminal handle', async () => {
+    await setup()
+    const session = await service().open(sid('s1'), 't1')
+    await session.write('ls\r')
+    await session.signal('SIGINT')
+    expect(fakeTerminal().writes).toEqual(['ls\r'])
+    expect(fakeTerminal().signals).toEqual(['SIGINT'])
+  })
+
+  it('closes the terminal and removes it from the service map', async () => {
+    await setup()
+    const session = await service().open(sid('s1'), 't1')
+    await session.close()
+    expect(fakeTerminal().terminated).toBe(true)
+    expect(service().get(sid('s1'), 't1')).toBeUndefined()
+  })
+})
