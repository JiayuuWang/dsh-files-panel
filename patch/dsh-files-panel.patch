+// @vitest-environment jsdom
+/** EditorPane: mounts one CodeMirror view, relays doc changes, destroys on unmount. */
+
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { cleanup, render } from '@testing-library/react'
+import { EditorView } from 'codemirror'
+import { EditorPane } from '../src/client/EditorPane.tsx'
+
+vi.mock('@replit/codemirror-vim', () => ({ vim: () => 'VIM_KEYMAP' }))
+vi.mock('@replit/codemirror-emacs', () => ({ emacs: () => 'EMACS_KEYMAP' }))
+vi.mock('@codemirror/lang-javascript', () => ({ javascript: () => 'JS_LANG' }))
+vi.mock('@codemirror/lang-json', () => ({ json: () => 'JSON_LANG' }))
+vi.mock('@codemirror/lang-html', () => ({ html: () => 'HTML_LANG' }))
+vi.mock('@codemirror/lang-css', () => ({ css: () => 'CSS_LANG' }))
+vi.mock('@codemirror/lang-markdown', () => ({ markdown: () => 'MD_LANG' }))
+vi.mock('@codemirror/lang-python', () => ({ python: () => 'PY_LANG' }))
+
+interface MockEditorViewInstance {
+  readonly config: { doc: string; extensions: unknown[]; parent: HTMLElement }
+  destroy(): void
+  emitDocChange(text: string, docChanged?: boolean): void
+}
+
+type MockEditorViewStatic = {
+  views: MockEditorViewInstance[]
+  lineWrapping: unknown[]
+  updateListener: { of(fn: (update: { docChanged: boolean; state: { doc: { toString(): string } } }) => void): unknown }
+  new (config: { doc: string; extensions: unknown[]; parent: HTMLElement }): MockEditorViewInstance
+}
+
+vi.mock('codemirror', () => {
+  class MockEditorView {
+    static readonly views: MockEditorViewInstance[] = []
+    static readonly lineWrapping: unknown[] = []
+    static updateListener = {
+      of: (fn: (update: { docChanged: boolean; state: { doc: { toString(): string } } }) => void) => fn,
+    }
+    private readonly listeners: ((update: { docChanged: boolean; state: { doc: { toString(): string } } }) => void)[] = []
+    constructor(readonly config: { doc: string; extensions: unknown[]; parent: HTMLElement }) {
+      for (const extension of config.extensions) {
+        if (typeof extension === 'function') {
+          this.listeners.push(extension as (update: { docChanged: boolean; state: { doc: { toString(): string } } }) => void)
+        }
+      }
+      MockEditorView.views.push(this)
+    }
+    destroy(): void {
+      const index = MockEditorView.views.indexOf(this)
+      if (index >= 0) MockEditorView.views.splice(index, 1)
+    }
+    emitDocChange(text: string, docChanged = true): void {
+      for (const listener of this.listeners) listener({ docChanged, state: { doc: { toString: () => text } } })
+    }
+  }
+  return { EditorView: MockEditorView, basicSetup: [] }
+})
+
+const MockView = EditorView as unknown as MockEditorViewStatic
+
+afterEach(() => {
+  cleanup()
+  MockView.views.length = 0
+})
+
+describe('EditorPane', () => {
+  it('mounts one view with the initial doc and reports it through onReady', () => {
+    const onReady = vi.fn()
+    render(<EditorPane value="alpha" onChange={() => {}} onReady={view => { onReady(view) }} />)
+    expect(MockView.views).toHaveLength(1)
+    expect(MockView.views[0]?.config.doc).toBe('alpha')
+    expect(MockView.views[0]?.config.parent).toBeInstanceOf(HTMLElement)
+    expect(onReady).toHaveBeenCalledWith(MockView.views[0])
+  })
+
+  it('relays document changes through onChange with the full text', () => {
+    const onChange = vi.fn()
+    render(<EditorPane value="alpha" onChange={onChange} />)
+    MockView.views[0]?.emitDocChange('bravo')
+    expect(onChange).toHaveBeenCalledWith('bravo')
+  })
+
+  it('ignores non-document updates (selection-only frames)', () => {
+    const onChange = vi.fn()
+    render(<EditorPane value="alpha" onChange={onChange} />)
+    MockView.views[0]?.emitDocChange('bravo', false)
+    expect(onChange).not.toHaveBeenCalled()
+  })
+
+  it('destroys its view on unmount', () => {
+    const view = render(<EditorPane value="alpha" onChange={() => {}} />)
+    expect(MockView.views).toHaveLength(1)
+    view.unmount()
+    expect(MockView.views).toHaveLength(0)
+  })
+
+  it('binds no extra keymap by default', () => {
+    render(<EditorPane value="alpha" onChange={() => {}} />)
+    expect(MockView.views[0]?.config.extensions).not.toContain('VIM_KEYMAP')
+    expect(MockView.views[0]?.config.extensions).not.toContain('EMACS_KEYMAP')
+  })
+
+  it('binds no syntax language without a filename', () => {
+    render(<EditorPane value="alpha" onChange={() => {}} />)
+    const extensions = MockView.views[0]?.config.extensions ?? []
+    expect(extensions).not.toContain('JS_LANG')
+  })
+
+  it('binds the matching language for known extensions', () => {
+    render(<EditorPane value="alpha" filename="x.ts" onChange={() => {}} />)
+    expect(MockView.views[0]?.config.extensions).toContain('JS_LANG')
+    cleanup()
+    render(<EditorPane value="alpha" filename="x.json" onChange={() => {}} />)
+    expect(MockView.views[0]?.config.extensions).toContain('JSON_LANG')
+    cleanup()
+    render(<EditorPane value="alpha" filename="x.md" onChange={() => {}} />)
+    expect(MockView.views[0]?.config.extensions).toContain('MD_LANG')
+  })
+
+  it('binds no language for an unknown extension or extension-less name', () => {
+    render(<EditorPane value="alpha" filename="x.unknown" onChange={() => {}} />)
+    expect(MockView.views[0]?.config.extensions).not.toContain('JS_LANG')
+    cleanup()
+    render(<EditorPane value="alpha" filename="Makefile" onChange={() => {}} />)
+    expect(MockView.views[0]?.config.extensions).not.toContain('JS_LANG')
+  })
+
+  it('binds the vim and emacs keymaps when selected', () => {
+    render(<EditorPane value="alpha" onChange={() => {}} keymap="vim" />)
+    expect(MockView.views[0]?.config.extensions).toContain('VIM_KEYMAP')
+    cleanup()
+    render(<EditorPane value="alpha" onChange={() => {}} keymap="emacs" />)
+    expect(MockView.views[0]?.config.extensions).toContain('EMACS_KEYMAP')
+  })
+})
