@@ -0,0 +1,42 @@
+// @vitest-environment jsdom
+/** ToggleExplorer: opens the details panel on files, or closes it when already there. */
+
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { cleanup, fireEvent, render, screen } from '@testing-library/react'
+import { ToggleExplorer } from '../src/client/skeleton/ToggleExplorer.tsx'
+import type { ToggleExplorerProps } from '../src/client/skeleton/ToggleExplorer.tsx'
+
+function setup(tab: 'tool' | 'files') {
+  const openDetails = vi.fn()
+  const closeDetails = vi.fn()
+  const setDetailsTab = vi.fn()
+  const componentProps = {
+    useStore: (selector: (s: { detailsTab: 'tool' | 'files' }) => unknown) => selector({ detailsTab: tab }),
+    actions: { setDetailsTab },
+    openDetails,
+    closeDetails,
+    t: (key: string) => key,
+  } as unknown as ToggleExplorerProps
+  render(<ToggleExplorer {...componentProps} />)
+  return { openDetails, closeDetails, setDetailsTab }
+}
+
+afterEach(cleanup)
+
+describe('ToggleExplorer', () => {
+  it('opens the details panel on the files tab from the tool tab', () => {
+    const s = setup('tool')
+    fireEvent.click(screen.getByRole('button', { name: 'details.toggleExplorer' }))
+    expect(s.openDetails).toHaveBeenCalledTimes(1)
+    expect(s.setDetailsTab).toHaveBeenCalledWith('files')
+    expect(s.closeDetails).not.toHaveBeenCalled()
+  })
+
+  it('closes the details panel when already on the files tab', () => {
+    const s = setup('files')
+    fireEvent.click(screen.getByRole('button', { name: 'details.toggleExplorer' }))
+    expect(s.closeDetails).toHaveBeenCalledTimes(1)
+    expect(s.setDetailsTab).toHaveBeenCalledWith('tool')
+    expect(s.openDetails).not.toHaveBeenCalled()
+  })
+})
