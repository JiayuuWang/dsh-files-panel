+  it('starts null and initializes on the first session', () => {
+    const store = createPaneStore().create()
+    expect(store.getSnapshot()).toEqual({ panes: null, focusedPaneId: null, fullscreenPaneId: null })
+    store.actions.init(sid('s1'))
+    expect(store.getSnapshot().panes).toEqual({ kind: 'leaf', paneId: 'pane-1', viewId: 'chat', sessionId: 's1' })
+  })
+
