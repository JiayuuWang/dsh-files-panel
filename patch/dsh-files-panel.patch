diff --git a/packages/host/apiproxy/tests/api-proxy-files.spec.ts b/packages/host/apiproxy/tests/api-proxy-files.spec.ts
new file mode 100644
index 0000000000..fcd09dd7ea
--- /dev/null
+++ b/packages/host/apiproxy/tests/api-proxy-files.spec.ts
@@ -0,0 +1,228 @@
+/** Wire behavior of the files domain over a real fs-backed workspace-files service. */
+
+import { mkdir, mkdtemp, rm, writeFile } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterAll, beforeAll, describe, expect, it } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import AgentRegistry, { Inbox } from '@deepseek-ai/dsh-agent'
+import type { Agent, AgentFactory } from '@deepseek-ai/dsh-agent'
+import SessionStore from '@deepseek-ai/dsh-session'
+import type { Session } from '@deepseek-ai/dsh-session'
+import Storage from '@deepseek-ai/dsh-storage'
+import { DomainFacility } from '@deepseek-ai/dsh-storage-domain'
+import UserQuestionService from '@deepseek-ai/dsh-user-questions'
+import LocalFileSystem from '@deepseek-ai/dsh-fs-local'
+import FsWorkspaceFiles from '@deepseek-ai/dsh-host-workspace-files-fs'
+import { createApiProxy } from '@deepseek-ai/dsh-host-apiproxy'
+import type { ApiProxy } from '@deepseek-ai/dsh-host-apiproxy/api'
+import type { RpcRequest, RpcResponse } from '@deepseek-ai/dsh-host-apiproxy/api/rpc'
+import { RpcId } from '@deepseek-ai/dsh-host-apiproxy/api/rpc'
+import { MemoryStorageBackend } from '../../../storage/storage-domain/tests/helpers/memory-backend.ts'
+
+let root: string
+let ctx: Context
+let api: ApiProxy
+let dispose: () => Promise<void>
+
+function stubAgent(session: Session): Agent {
+  const inbox = new Inbox(session, { inserted: () => {}, discarded: () => {}, claimed: () => {} })
+  return {
+    id: session.id,
+    options: {},
+    session,
+    inbox,
+    status: 'idle',
+    ctx: new Context(),
+    send: () => {},
+    followup: () => {},
+    steer: () => ({ outcome: Promise.resolve({ status: 'rejected' as const }) }),
+    // Real inbox delivery: the gateway's edit notice lands in next-step, the
+    // same list a live agent loop would claim at the next pre-step.
+    inject: message => { inbox.append('next-step', message) },
+    cancel() {},
+    runMaintenance: job => job(new AbortController().signal),
+    whenIdle: () => Promise.resolve(),
+  }
+}
+
+beforeAll(async () => {
+  root = await mkdtemp(join(tmpdir(), 'dsh-apiproxy-files-'))
+  await mkdir(join(root, 'sub'))
+  await writeFile(join(root, 'a.txt'), 'alpha')
+  await writeFile(join(root, 'big.txt'), 'x'.repeat(128))
+
+  ctx = new Context()
+  // createApiProxy registers a question provider eagerly, so the gateway's
+  // construction dependencies must be composed even for files-only tests.
+  await ctx.plugin(SessionStore)
+  await ctx.plugin(AgentRegistry)
+  await ctx.plugin(UserQuestionService)
+  await ctx.plugin(Storage)
+  ctx.storage.backend.register('memory', new MemoryStorageBackend())
+  const storageDomain = new DomainFacility(ctx, { backend: 'memory', routes: {} })
+  ctx.storage.mount('domain', storageDomain)
+  ctx.provide('storageDomain', storageDomain)
+  ctx.provide('sessionPersistence', { list: () => Promise.resolve([]) } as never)
+
+  const factory: AgentFactory = {
+    async createAgent(_ownerCtx, options) {
+      const session = ctx.sessions.create(
+        options.sessionId,
+        options.meta === undefined ? {} : { meta: options.meta },
+      )
+      const agent = stubAgent(session)
+      const unregister = ctx.agents.register(agent)
+      return {
+        agent,
+        dispose: () => {
+          unregister()
+          return Promise.resolve()
+        },
+      }
+    },
+    async resume() {
+      throw new Error('test harness has no persisted sessions')
+    },
+  }
+  ctx.agents.setFactory(factory)
+
+  const fsFiber = ctx.plugin(LocalFileSystem, { cwd: root })
+  const serviceFiber = ctx.plugin(FsWorkspaceFiles, { maxEntries: 1000, maxReadBytes: 64 })
+  await fsFiber.await()
+  await serviceFiber.await()
+  api = createApiProxy(ctx, { defaultModelSelection: () => ({ provider: 'test', model: 'test-model' }), cwd: root })
+  dispose = async () => {
+    await serviceFiber.dispose()
+    await fsFiber.dispose()
+  }
+})
+
+afterAll(async () => {
+  await dispose()
+  await rm(root, { recursive: true, force: true })
+})
+
+let nextRpc = 1
+
+function request<P>(payload: P): RpcRequest<P> {
+  return { rpcId: RpcId(`files-${String(nextRpc++)}`), payload }
+}
+
+async function openSession(): Promise<string> {
+  const response = await api.sessions.create(request({ cwd: root }))
+  if (!response.result.ok) throw new Error('unreachable')
+  return response.result.value.sessionId
+}
+
+describe('files.list', () => {
+  it('lists one directory level over the real backend and echoes the rpcId', async () => {
+    const rpc = request({ path: root })
+    const response = await api.files.list(rpc, new AbortController().signal)
+    expect(response.rpcId).toBe(rpc.rpcId)
+    if (!response.result.ok) throw new Error('unreachable')
+    expect(response.result.value.path).toBe(root)
+    expect(response.result.value.truncated).toBe(false)
+    expect(response.result.value.entries.map(entry => entry.name)).toEqual(['a.txt', 'big.txt', 'sub'])
+    expect(response.result.value.entries.find(entry => entry.name === 'sub')?.type).toBe('directory')
+  })
+
+  it('maps an absent directory to files-not-found', async () => {
+    const gone = join(root, 'gone')
+    const response = await api.files.list(request({ path: gone }), new AbortController().signal)
+    expect(response.result).toMatchObject({
+      ok: false,
+      error: { code: 'files-not-found', details: { path: gone } },
+    })
+  })
+
+  it('maps an aborted caller to cancelled', async () => {
+    const controller = new AbortController()
+    controller.abort()
+    const response = await api.files.list(request({ path: root }), controller.signal)
+    expect(response.result).toMatchObject({ ok: false, error: { code: 'cancelled' } })
+  })
+})
+
+describe('files.read', () => {
+  it('reads one text file whole with its freshness version', async () => {
+    const rpc = request({ path: join(root, 'a.txt') })
+    const response = await api.files.read(rpc, new AbortController().signal)
+    expect(response.rpcId).toBe(rpc.rpcId)
+    if (!response.result.ok) throw new Error('unreachable')
+    expect(response.result.value).toMatchObject({ path: join(root, 'a.txt'), size: 5, content: 'alpha' })
+    expect(response.result.value.version.length).toBeGreaterThan(0)
+  })
+
+  it('maps a directory to files-not-file and an oversized file to files-too-large', async () => {
+    const directory: RpcResponse<unknown> = await api.files.read(request({ path: join(root, 'sub') }), new AbortController().signal)
+    expect(directory.result).toMatchObject({ ok: false, error: { code: 'files-not-file' } })
+    const big: RpcResponse<unknown> = await api.files.read(request({ path: join(root, 'big.txt') }), new AbortController().signal)
+    expect(big.result).toMatchObject({ ok: false, error: { code: 'files-too-large' } })
+  })
+})
+
+describe('files.write', () => {
+  it('commits a guarded write, logs the audit event, and queues a model notice', async () => {
+    const sessionId = await openSession()
+    const read = await api.files.read(request({ path: join(root, 'a.txt') }), new AbortController().signal)
+    if (!read.result.ok) throw new Error('unreachable')
+    const rpc = request({
+      sessionId: sessionId as never,
+      path: join(root, 'a.txt'),
+      content: 'replaced',
+      expectedVersion: read.result.value.version,
+    })
+    const response = await api.files.write(rpc, new AbortController().signal)
+    expect(response.rpcId).toBe(rpc.rpcId)
+    if (!response.result.ok) throw new Error('unreachable')
+    expect(response.result.value).toMatchObject({ path: join(root, 'a.txt'), operation: 'update', size: 8 })
+
+    // The human edit is a durable audit event on the session log.
+    const agent = ctx.agents.get(sessionId as never)
+    const audit = agent?.session.events.findLast(event => event.type === 'user/file-edit')
+    expect(audit?.type === 'user/file-edit' && audit.data).toMatchObject({
+      path: join(root, 'a.txt'),
+      operation: 'update',
+      size: 8,
+    })
+
+    // The model-facing notice entered the live inbox (claimed and logged as a
+    // user/message at the next pre-step).
+    const notice = agent?.inbox.nextStep.findLast(message =>
+      message.content.some(part => part.type === 'text' && part.text.includes('manually edited')))
+    expect(notice).toBeDefined()
+    const noticeText = notice?.content.find(part => part.type === 'text')
+    expect(noticeText?.type === 'text' && noticeText.text).toContain(`"${join(root, 'a.txt')}"`)
+
+    // The file content actually changed.
+    const reread = await api.files.read(request({ path: join(root, 'a.txt') }), new AbortController().signal)
+    expect(reread.result.ok && reread.result.value.content).toBe('replaced')
+  })
+
+  it('rejects a stale expected version with files-stale-version without touching the file', async () => {
+    const sessionId = await openSession()
+    const read = await api.files.read(request({ path: join(root, 'a.txt') }), new AbortController().signal)
+    if (!read.result.ok) throw new Error('unreachable')
+    const stale = read.result.value.version
+    await api.files.write(request({ sessionId: sessionId as never, path: join(root, 'a.txt'), content: 'first', expectedVersion: stale }), new AbortController().signal)
+    const response = await api.files.write(
+      request({ sessionId: sessionId as never, path: join(root, 'a.txt'), content: 'clobber', expectedVersion: stale }),
+      new AbortController().signal,
+    )
+    expect(response.result).toMatchObject({
+      ok: false,
+      error: { code: 'files-stale-version', details: { path: join(root, 'a.txt') } },
+    })
+    const reread = await api.files.read(request({ path: join(root, 'a.txt') }), new AbortController().signal)
+    expect(reread.result.ok && reread.result.value.content).toBe('first')
+  })
+
+  it('refuses an unknown session with session-not-found', async () => {
+    const response = await api.files.write(
+      request({ sessionId: 'no-such-session' as never, path: join(root, 'a.txt'), content: 'x' }),
+      new AbortController().signal,
+    )
+    expect(response.result).toMatchObject({ ok: false, error: { code: 'session-not-found' } })
+  })
+})
