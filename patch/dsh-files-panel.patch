@@ -0,0 +1,378 @@
+// @vitest-environment jsdom
+/** FilesPanel presentation: tree loading/expansion, selection, and edit/save states. */
+
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { cleanup, fireEvent, render, screen, waitFor } from '@testing-library/react'
+import { RpcId } from '@deepseek-ai/dsh-client-connection/client'
+import type { FileEntry, RpcResponse, SessionId, WorkspaceView } from '@deepseek-ai/dsh-api-remotes/client'
+import { EditorView } from 'codemirror'
+import { FilesPanel, partitionEntries } from '../src/client/FilesPanel.tsx'
+import type { FilesPanelProps } from '../src/client/contract.ts'
+import { en } from '../src/client/locales.ts'
+
+vi.mock('@replit/codemirror-vim', () => ({ vim: () => 'VIM_KEYMAP' }))
+vi.mock('@replit/codemirror-emacs', () => ({ emacs: () => 'EMACS_KEYMAP' }))
+
+// Drive the EditorPane seam through a scripted CodeMirror double: mount
+// configs are captured, doc changes are emitted on demand.
+interface MockEditorViewInstance {
+  readonly config: { doc: string; extensions: unknown[]; parent: HTMLElement }
+  destroy(): void
+  emitDocChange(text: string): void
+}
+
+type MockEditorViewStatic = {
+  views: MockEditorViewInstance[]
+  lineWrapping: unknown[]
+  updateListener: { of(fn: (update: { docChanged: boolean; state: { doc: { toString(): string } } }) => void): unknown }
+  new (config: { doc: string; extensions: unknown[]; parent: HTMLElement }): MockEditorViewInstance
+}
+
+vi.mock('codemirror', () => {
+  class MockEditorView {
+    static readonly views: MockEditorViewInstance[] = []
+    static readonly lineWrapping: unknown[] = []
+    static updateListener = {
+      of: (fn: (update: { docChanged: boolean; state: { doc: { toString(): string } } }) => void) => fn,
+    }
+    private readonly listeners: ((update: { docChanged: boolean; state: { doc: { toString(): string } } }) => void)[] = []
+    constructor(readonly config: { doc: string; extensions: unknown[]; parent: HTMLElement }) {
+      for (const extension of config.extensions) {
+        if (typeof extension === 'function') {
+          this.listeners.push(extension as (update: { docChanged: boolean; state: { doc: { toString(): string } } }) => void)
+        }
+      }
+      MockEditorView.views.push(this)
+    }
+    destroy(): void {
+      const index = MockEditorView.views.indexOf(this)
+      if (index >= 0) MockEditorView.views.splice(index, 1)
+    }
+    emitDocChange(text: string): void {
+      for (const listener of this.listeners) listener({ docChanged: true, state: { doc: { toString: () => text } } })
+    }
+  }
+  return { EditorView: MockEditorView, basicSetup: [] }
+})
+
+const MockView = EditorView as unknown as MockEditorViewStatic
+
+/** English dictionary with the {name} parameter substituted. */
+const t: FilesPanelProps['t'] = (key, params) => (
+  (en as Record<string, string>)[key] ?? key
+).replace('{name}', (params as { name?: string } | undefined)?.name ?? '') as never
+
+// The panel never reads the remaining standard-kit seats; stub them as
+// never-called functions (the sidebar spec's pattern).
+const neverHook = (() => { throw new Error('panel must not read this seat') }) as never
+
+function entry(name: string, type: FileEntry['type'] = 'file'): FileEntry {
+  return { name, path: `/ws/${name}`, type, hidden: name.startsWith('.') }
+}
+
+function ok<T>(value: T): RpcResponse<T> {
+  return { rpcId: RpcId(`r-${Math.random()}`), result: { ok: true, value } }
+}
+
+function fail(code: string, message: string, path: string): RpcResponse<never> {
+  return { rpcId: RpcId('r-err'), result: { ok: false, error: { code, message, details: { path } } as never } }
+}
+
+function workspace(path: string, sessionIds: string[]): WorkspaceView {
+  return {
+    workspaceId: `w-${path}` as never,
+    path,
+    title: path,
+    sessionIds: sessionIds as SessionId[],
+    createdAt: '0',
+    updatedAt: '0',
+  }
+}
+
+interface Harness {
+  listDirectory: ReturnType<typeof vi.fn>
+  readFile: ReturnType<typeof vi.fn>
+  writeFile: ReturnType<typeof vi.fn>
+}
+
+function mountPanel(
+  sessionIds: string[],
+  path = '/ws',
+  listImpl: FilesPanelProps['listDirectory'] = () => Promise.resolve(fail('internal', 'not scripted', path)),
+  readImpl: FilesPanelProps['readFile'] = () => Promise.resolve(fail('internal', 'not scripted', path)),
+  writeImpl: FilesPanelProps['writeFile'] = () => Promise.resolve(fail('internal', 'not scripted', path)),
+): Harness {
+  const listDirectory = vi.fn(listImpl)
+  const readFile = vi.fn(readImpl)
+  const writeFile = vi.fn(writeImpl)
+  render(
+    <FilesPanel
+      sessionId={'s1' as SessionId}
+      useSession={neverHook}
+      useSessions={neverHook}
+      useProjection={neverHook}
+      useInput={neverHook}
+      inputActions={neverHook}
+      useWorkspaces={selector => selector({
+        items: [workspace(path, sessionIds)],
+        archivedSessionIds: [],
+        state: 'idle' as const,
+        phase: 'pending' as const,
+        error: null,
+        baselinesReady: true,
+        recentWorkspaceId: undefined,
+      })}
+      listDirectory={listDirectory as FilesPanelProps['listDirectory']}
+      readFile={readFile as FilesPanelProps['readFile']}
+      writeFile={writeFile as FilesPanelProps['writeFile']}
+      t={t}
+    />,
+  )
+  return { listDirectory, readFile, writeFile }
+}
+
+const FILE_LIST: FilesPanelProps['listDirectory'] = () => Promise.resolve(
+  ok({ path: '/ws', entries: [entry('a.txt')], truncated: false }),
+)
+const FILE_READ: FilesPanelProps['readFile'] = () => Promise.resolve(
+  ok({ path: '/ws/a.txt', size: 5, version: 'v1', content: 'alpha' }),
+)
+
+afterEach(() => {
+  cleanup()
+  MockView.views.length = 0
+})
+
+describe('partitionEntries', () => {
+  it('groups directories before files, keeping the backend name order inside each group', () => {
+    const rows = [entry('a-dir', 'directory'), entry('a.txt'), entry('b.txt'), entry('z-dir', 'directory')]
+    const { directories, files } = partitionEntries(rows)
+    expect(directories.map(row => row.name)).toEqual(['a-dir', 'z-dir'])
+    expect(files.map(row => row.name)).toEqual(['a.txt', 'b.txt'])
+  })
+})
+
+describe('FilesPanel', () => {
+  it('shows the no-workspace empty state and never lists', () => {
+    const h = mountPanel(['s2'])
+    expect(screen.getByText('This session has no workspace')).toBeTruthy()
+    expect(h.listDirectory).not.toHaveBeenCalled()
+  })
+
+  it('loads the workspace root and renders directories before files', async () => {
+    const h = mountPanel(['s1'], '/ws', () => Promise.resolve(
+      ok({ path: '/ws', entries: [entry('a.txt'), entry('b.txt'), entry('sub', 'directory')], truncated: false }),
+    ))
+    await waitFor(() => expect(h.listDirectory).toHaveBeenCalledWith('/ws'))
+    await waitFor(() => expect(screen.getAllByRole('button').length).toBeGreaterThan(2))
+    const rows = screen.getAllByRole('button').filter(row => row.className.includes('row'))
+    expect(rows.map(row => row.textContent)).toEqual(['▸sub', 'a.txt', 'b.txt'])
+  })
+
+  it('loads a directory level on expand and collapses it again', async () => {
+    const h = mountPanel(['s1'], '/ws', (path: string) => Promise.resolve(
+      path === '/ws'
+        ? ok({ path, entries: [entry('sub', 'directory')], truncated: false })
+        : ok({ path, entries: [entry('nested.txt')], truncated: false }),
+    ))
+    await waitFor(() => expect(h.listDirectory).toHaveBeenCalledWith('/ws'))
+    const dirRow = await screen.findByRole('button', { name: 'Directory sub' })
+    expect(dirRow.getAttribute('aria-expanded')).toBe('false')
+    fireEvent.click(dirRow)
+    await waitFor(() => expect(h.listDirectory).toHaveBeenCalledWith('/ws/sub'))
+    await waitFor(() => expect(screen.getByRole('button', { name: 'File nested.txt' })).toBeTruthy())
+    expect(dirRow.getAttribute('aria-expanded')).toBe('true')
+    fireEvent.click(dirRow)
+    expect(dirRow.getAttribute('aria-expanded')).toBe('false')
+    // Re-expanding reuses the cached level: no second wire call.
+    fireEvent.click(dirRow)
+    expect(dirRow.getAttribute('aria-expanded')).toBe('true')
+    await waitFor(() => expect(screen.getByRole('button', { name: 'File nested.txt' })).toBeTruthy())
+    expect(h.listDirectory.mock.calls.filter(call => call[0] === '/ws/sub')).toHaveLength(1)
+  })
+
+  it('mounts the editor with the selected file content', async () => {
+    const h = mountPanel(['s1'], '/ws', FILE_LIST, FILE_READ)
+    await waitFor(() => expect(h.listDirectory).toHaveBeenCalledWith('/ws'))
+    expect(screen.getByText('Select a file to view its content')).toBeTruthy()
+    fireEvent.click(await screen.findByRole('button', { name: 'File a.txt' }))
+    await waitFor(() => expect(h.readFile).toHaveBeenCalledWith('/ws/a.txt'))
+    await waitFor(() => expect(MockView.views).toHaveLength(1))
+    expect(MockView.views[0]?.config.doc).toBe('alpha')
+  })
+
+  it('saves a dirty buffer with the read version and clears the dirty state', async () => {
+    const h = mountPanel(['s1'], '/ws', FILE_LIST, FILE_READ, () => Promise.resolve(
+      ok({ path: '/ws/a.txt', operation: 'update', size: 6, version: 'v2' }),
+    ))
+    await waitFor(() => expect(h.listDirectory).toHaveBeenCalledWith('/ws'))
+    fireEvent.click(await screen.findByRole('button', { name: 'File a.txt' }))
+    await waitFor(() => expect(MockView.views).toHaveLength(1))
+    MockView.views[0]?.emitDocChange('bravo')
+    await waitFor(() => expect(screen.getByText('Unsaved')).toBeTruthy())
+    fireEvent.click(screen.getByRole('button', { name: 'Save' }))
+    await waitFor(() => expect(h.writeFile).toHaveBeenCalledWith({
+      sessionId: 's1',
+      path: '/ws/a.txt',
+      content: 'bravo',
+      expectedVersion: 'v1',
+    }))
+    await waitFor(() => expect(screen.queryByText('Unsaved')).toBeNull())
+  })
+
+  it('commits a save on Ctrl+S', async () => {
+    const h = mountPanel(['s1'], '/ws', FILE_LIST, FILE_READ, () => Promise.resolve(
+      ok({ path: '/ws/a.txt', operation: 'update', size: 6, version: 'v2' }),
+    ))
+    await waitFor(() => expect(h.listDirectory).toHaveBeenCalledWith('/ws'))
+    fireEvent.click(await screen.findByRole('button', { name: 'File a.txt' }))
+    await waitFor(() => expect(MockView.views).toHaveLength(1))
+    MockView.views[0]?.emitDocChange('bravo')
+    const preview = document.querySelector('[class*=preview]') as HTMLElement
+    fireEvent.keyDown(preview, { key: 's', ctrlKey: true })
+    await waitFor(() => expect(h.writeFile).toHaveBeenCalledTimes(1))
+    await waitFor(() => expect(screen.queryByText('Unsaved')).toBeNull())
+  })
+
+  it('commits a save on Meta+S and ignores unrelated keys', async () => {
+    const h = mountPanel(['s1'], '/ws', FILE_LIST, FILE_READ, () => Promise.resolve(
+      ok({ path: '/ws/a.txt', operation: 'update', size: 6, version: 'v2' }),
+    ))
+    await waitFor(() => expect(h.listDirectory).toHaveBeenCalledWith('/ws'))
+    fireEvent.click(await screen.findByRole('button', { name: 'File a.txt' }))
+    await waitFor(() => expect(MockView.views).toHaveLength(1))
+    MockView.views[0]?.emitDocChange('bravo')
+    const preview = document.querySelector('[class*=preview]') as HTMLElement
+    fireEvent.keyDown(preview, { key: 'a' })
+    expect(h.writeFile).not.toHaveBeenCalled()
+    fireEvent.keyDown(preview, { key: 's', metaKey: true })
+    await waitFor(() => expect(h.writeFile).toHaveBeenCalledTimes(1))
+  })
+
+  it('ignores a save shortcut while no file is open or a save is in flight', async () => {
+    let resolveWrite: (value: RpcResponse<{ path: string; operation: 'update'; size: number; version: string }>) => void = () => {}
+    const pending = new Promise<RpcResponse<{ path: string; operation: 'update'; size: number; version: string }>>(resolve => {
+      resolveWrite = resolve
+    })
+    const h = mountPanel(['s1'], '/ws', FILE_LIST, FILE_READ, () => pending)
+    await waitFor(() => expect(h.listDirectory).toHaveBeenCalledWith('/ws'))
+    const preview = document.querySelector('[class*=preview]') as HTMLElement
+    // Nothing open: the shortcut is a no-op.
+    fireEvent.keyDown(preview, { key: 's', ctrlKey: true })
+    expect(h.writeFile).not.toHaveBeenCalled()
+    // In-flight save: a second shortcut does not double-submit.
+    fireEvent.click(await screen.findByRole('button', { name: 'File a.txt' }))
+    await waitFor(() => expect(MockView.views).toHaveLength(1))
+    MockView.views[0]?.emitDocChange('bravo')
+    await waitFor(() => expect(screen.getByText('Unsaved')).toBeTruthy())
+    fireEvent.click(screen.getByRole('button', { name: 'Save' }))
+    await waitFor(() => expect(h.writeFile).toHaveBeenCalledTimes(1))
+    fireEvent.keyDown(preview, { key: 's', ctrlKey: true })
+    expect(h.writeFile).toHaveBeenCalledTimes(1)
+    resolveWrite(ok({ path: '/ws/a.txt', operation: 'update', size: 6, version: 'v2' }))
+    await waitFor(() => expect(screen.queryByText('Unsaved')).toBeNull())
+  })
+
+  it('flags a stale-version save as a conflict and reloads on demand', async () => {
+    const write = vi.fn<(payload: { path: string }) => Promise<RpcResponse<{ path: string; operation: 'update'; size: number; version: string }>>>()
+    write.mockResolvedValueOnce(fail('files-stale-version', 'file changed since it was read', '/ws/a.txt'))
+    const read = vi.fn<() => Promise<RpcResponse<{ path: string; size: number; version: string; content: string }>>>()
+    read.mockResolvedValueOnce(ok({ path: '/ws/a.txt', size: 5, version: 'v1', content: 'alpha' }))
+    read.mockResolvedValue(ok({ path: '/ws/a.txt', size: 9, version: 'v3', content: 'elsewhere' }))
+    const h: Harness = mountPanel(['s1'], '/ws', FILE_LIST, read as never, write as never)
+    await waitFor(() => expect(h.listDirectory).toHaveBeenCalledWith('/ws'))
+    fireEvent.click(await screen.findByRole('button', { name: 'File a.txt' }))
+    await waitFor(() => expect(MockView.views).toHaveLength(1))
+    MockView.views[0]?.emitDocChange('mine')
+    await waitFor(() => expect(screen.getByText('Unsaved')).toBeTruthy())
+    fireEvent.click(screen.getByRole('button', { name: 'Save' }))
+    await waitFor(() => expect(screen.getByText(/This file changed elsewhere/)).toBeTruthy())
+    fireEvent.click(screen.getByRole('button', { name: 'Reload' }))
+    // The reload re-reads into a fresh editor mount: the single surviving
+    // view carries the on-disk content, and the read went over the wire twice.
+    await waitFor(() => expect(h.readFile).toHaveBeenCalledTimes(2))
+    await waitFor(() => expect(MockView.views).toHaveLength(1))
+    expect(MockView.views[0]?.config.doc).toBe('elsewhere')
+  })
+
+  it('renders non-conflict save errors without the reload affordance', async () => {
+    const h = mountPanel(['s1'], '/ws', FILE_LIST, FILE_READ, () => Promise.resolve(
+      fail('files-permission-denied', 'read-only directory', '/ws/a.txt'),
+    ))
+    await waitFor(() => expect(h.listDirectory).toHaveBeenCalledWith('/ws'))
+    fireEvent.click(await screen.findByRole('button', { name: 'File a.txt' }))
+    await waitFor(() => expect(MockView.views).toHaveLength(1))
+    MockView.views[0]?.emitDocChange('mine')
+    await waitFor(() => expect(screen.getByText('Unsaved')).toBeTruthy())
+    fireEvent.click(screen.getByRole('button', { name: 'Save' }))
+    await waitFor(() => expect(screen.getByText('files-permission-denied: read-only directory')).toBeTruthy())
+    expect(screen.queryByRole('button', { name: 'Reload' })).toBeNull()
+  })
+
+  it('renders a child-level error note for a failed directory expansion', async () => {
+    const list = vi.fn<(path: string) => Promise<RpcResponse<{ path: string; entries: FileEntry[]; truncated: boolean }>>>()
+    list.mockImplementation(path => Promise.resolve(path === '/ws'
+      ? ok({ path, entries: [entry('sub', 'directory')], truncated: false })
+      : fail('files-io-error', 'scan failed', path)))
+    const h: Harness = mountPanel(['s1'], '/ws', list as never)
+    await waitFor(() => expect(h.listDirectory).toHaveBeenCalledWith('/ws'))
+    fireEvent.click(await screen.findByRole('button', { name: 'Directory sub' }))
+    await waitFor(() => expect(screen.getByText('files-io-error: scan failed')).toBeTruthy())
+  })
+
+  it('renders nothing under an expanded empty directory', async () => {
+    const h = mountPanel(['s1'], '/ws', (path: string) => Promise.resolve(
+      ok({ path, entries: path === '/ws' ? [entry('sub', 'directory')] : [], truncated: false }),
+    ))
+    await waitFor(() => expect(h.listDirectory).toHaveBeenCalledWith('/ws'))
+    const dirRow = await screen.findByRole('button', { name: 'Directory sub' })
+    fireEvent.click(dirRow)
+    await waitFor(() => expect(h.listDirectory).toHaveBeenCalledWith('/ws/sub'))
+    expect(dirRow.getAttribute('aria-expanded')).toBe('true')
+    expect(screen.queryByText('Loading…')).toBeNull()
+    expect(screen.getAllByRole('button').filter(row => row.className.includes('row'))).toHaveLength(1)
+  })
+
+  it('flags a truncated root listing and reloads it on refresh', async () => {
+    const h = mountPanel(['s1'], '/ws', () => Promise.resolve(
+      ok({ path: '/ws', entries: [entry('a.txt')], truncated: true }),
+    ))
+    await waitFor(() => expect(h.listDirectory).toHaveBeenCalledWith('/ws'))
+    await waitFor(() => expect(screen.getByText('Too many entries; only the beginning is shown')).toBeTruthy())
+    fireEvent.click(screen.getByRole('button', { name: 'Refresh' }))
+    await waitFor(() => expect(h.listDirectory).toHaveBeenCalledTimes(2))
+  })
+
+  it('switches the editor keymap and keeps the current buffer', async () => {
+    const h = mountPanel(['s1'], '/ws', FILE_LIST, FILE_READ)
+    await waitFor(() => expect(h.listDirectory).toHaveBeenCalledWith('/ws'))
+    fireEvent.click(await screen.findByRole('button', { name: 'File a.txt' }))
+    await waitFor(() => expect(MockView.views).toHaveLength(1))
+    MockView.views[0]?.emitDocChange('bravo')
+    await waitFor(() => expect(screen.getByText('Unsaved')).toBeTruthy())
+    fireEvent.change(screen.getByLabelText('Keymap'), { target: { value: 'vim' } })
+    // The remounted view (old destroyed, new created) binds the chosen
+    // keymap and keeps the buffer (and therefore the dirty state).
+    await waitFor(() => expect(MockView.views).toHaveLength(1))
+    expect(MockView.views[0]?.config.extensions).toContain('VIM_KEYMAP')
+    expect(MockView.views[0]?.config.doc).toBe('bravo')
+    expect(screen.getByText('Unsaved')).toBeTruthy()
+  })
+
+  it('renders read errors with code and message', async () => {
+    const h = mountPanel(['s1'], '/ws', FILE_LIST, () => Promise.resolve(
+      fail('files-too-large', 'exceeds the 1048576-byte read bound', '/ws/a.txt'),
+    ))
+    await waitFor(() => expect(h.listDirectory).toHaveBeenCalledWith('/ws'))
+    fireEvent.click(await screen.findByRole('button', { name: 'File a.txt' }))
+    await waitFor(() => expect(screen.getByText('files-too-large: exceeds the 1048576-byte read bound')).toBeTruthy())
+  })
+
+  it('renders a failed root listing as an error', async () => {
+    const h = mountPanel(['s1'], '/ws', () => Promise.resolve(
+      fail('files-permission-denied', 'locked', '/ws'),
+    ))
+    await waitFor(() => expect(h.listDirectory).toHaveBeenCalledWith('/ws'))
+    await waitFor(() => expect(screen.getByText('files-permission-denied: locked')).toBeTruthy())
+  })
+})
