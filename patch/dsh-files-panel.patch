+/** Terminal view-ring slot registration and its terminal.* wire callbacks. */
+import { Context } from '@deepseek-ai/cordis'
+import { describe, expect, it, vi } from 'vitest'
+import { SlotRegistry } from '@deepseek-ai/dsh-client-runtime/client'
+import { LocaleRuntime } from '@deepseek-ai/dsh-client-locale/client'
+import { apply, inject } from '@deepseek-ai/dsh-client-ui-terminal/client'
+import type { TerminalInjected } from '@deepseek-ai/dsh-client-ui-terminal/client'
+import { apply as hostApply } from '../src/index.ts'
+
+async function bench(declare = true) {
+  const ctx = new Context()
+  await ctx.plugin(SlotRegistry).await()
+  const connection = {
+    api: {
+      terminal: { open: vi.fn(), write: vi.fn(), read: vi.fn(), signal: vi.fn(), close: vi.fn(), shells: vi.fn() },
+    },
+  }
+  ctx.provide('connection', connection)
+  ctx.provide('locale', new LocaleRuntime(ctx))
+  const slots = ctx.get('slots') as SlotRegistry
+  if (declare) {
+    slots.register(
+      { name: 'root', children: { 'conversation.view': { kind: 'list', scope: 'session' } } } as never,
+      () => null,
+    )
+  }
+  return { ctx, slots, connection }
+}
+
+describe('ui-terminal apply', () => {
+  it('declares only the services it uses', () => {
+    expect(inject).toEqual(['slots', 'connection', 'locale'])
+  })
+
+  it('provides no host-side behavior on the node half', () => {
+    expect(hostApply()).toBeUndefined()
+  })
+
+  it('registers the terminal view and injects the terminal.* wire calls', async () => {
+    const b = await bench()
+    await b.ctx.plugin({ inject: [...inject], apply }).await()
+    const entries = b.slots.entries('conversation.view')
+    expect(entries).toHaveLength(1)
+    expect(entries[0]!.options.id).toBe('terminal')
+    const injected = (entries[0]!.inject as unknown as () => TerminalInjected)()
+    expect(Object.keys(injected)).toEqual(['openTerminal', 'writeTerminal', 'readTerminal', 'signalTerminal', 'closeTerminal', 'listTerminalShells'])
+    const signal = new AbortController().signal
+    void injected.openTerminal({ sessionId: 's1' as never, terminalId: 't1', cwd: '/w' }, signal)
+    expect(b.connection.api.terminal.open).toHaveBeenCalledWith({ sessionId: 's1', terminalId: 't1', cwd: '/w' }, signal)
+    void injected.writeTerminal({ sessionId: 's1' as never, terminalId: 't1', data: 'ls\r' })
+    expect(b.connection.api.terminal.write).toHaveBeenCalledWith({ sessionId: 's1', terminalId: 't1', data: 'ls\r' }, undefined)
+    void injected.readTerminal({ sessionId: 's1' as never, terminalId: 't1', cursor: 3 })
+    expect(b.connection.api.terminal.read).toHaveBeenCalledWith({ sessionId: 's1', terminalId: 't1', cursor: 3 }, undefined)
+    void injected.signalTerminal({ sessionId: 's1' as never, terminalId: 't1', signal: 'SIGINT' })
+    expect(b.connection.api.terminal.signal).toHaveBeenCalledWith({ sessionId: 's1', terminalId: 't1', signal: 'SIGINT' }, undefined)
+    void injected.closeTerminal({ sessionId: 's1' as never, terminalId: 't1' })
+    expect(b.connection.api.terminal.close).toHaveBeenCalledWith({ sessionId: 's1', terminalId: 't1' }, undefined)
+    void injected.listTerminalShells({})
+    expect(b.connection.api.terminal.shells).toHaveBeenCalledWith({}, undefined)
+  })
+
+  it('installs once a later declaration appears and removes on teardown', async () => {
+    const b = await bench(false)
+    const fiber = b.ctx.plugin({ inject: [...inject], apply })
+    await fiber.await()
+    expect(b.slots.entries('conversation.view')).toHaveLength(0)
+    b.slots.register(
+      { name: 'root', children: { 'conversation.view': { kind: 'list', scope: 'session' } } } as never,
+      () => null,
+    )
+    await vi.waitFor(() => expect(b.slots.entries('conversation.view')).toHaveLength(1))
+    await fiber.dispose()
+    expect(b.slots.entries('conversation.view')).toHaveLength(0)
+  })
+})
