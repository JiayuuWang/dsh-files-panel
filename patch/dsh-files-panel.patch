@@ -0,0 +1,117 @@
+// @vitest-environment jsdom
+/** PaneTree: renders leaves/splits, drives chrome verbs, and drags dividers. */
+
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { cleanup, fireEvent, render } from '@testing-library/react'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import { PaneTree } from '../src/client/PaneTree.tsx'
+import type { PaneNode } from '../src/client/contract/panes.ts'
+
+const sid = (id: string): SessionId => id as SessionId
+
+const TABS = [
+  { id: 'chat', label: 'Chat' },
+  { id: 'trajectory', label: 'Trajectory' },
+  { id: 'terminal', label: 'Terminal' },
+]
+
+function renderTree(root: PaneNode, overrides: Partial<Parameters<typeof PaneTree>[0]> = {}) {
+  const onFocus = vi.fn()
+  const onSplit = vi.fn()
+  const onClose = vi.fn()
+  const onFullscreen = vi.fn()
+  const onResize = vi.fn()
+  const view = render(
+    <PaneTree
+      root={root}
+      focusedPaneId={null}
+      fullscreenPaneId={null}
+      tabs={TABS}
+      renderView={leaf => <div data-view-id={leaf.viewId} />}
+      onFocus={onFocus}
+      onSplit={onSplit}
+      onClose={onClose}
+      onFullscreen={onFullscreen}
+      onResize={onResize}
+      t={key => key}
+      {...overrides}
+    />,
+  )
+  return { view, onFocus, onSplit, onClose, onFullscreen, onResize }
+}
+
+afterEach(cleanup)
+
+describe('PaneTree', () => {
+  it('renders a single leaf with its view and chrome', () => {
+    const { view } = renderTree({ kind: 'leaf', paneId: 'pane-1', viewId: 'chat', sessionId: sid('s1') })
+    expect(view.container.querySelector('[data-view-id="chat"]')).toBeTruthy()
+    expect(view.getByRole('button', { name: 'pane.splitRight' })).toBeTruthy()
+    expect(view.container.querySelector('[data-conversation-composer-overlay]')).toBeTruthy()
+    expect(view.container.querySelector('[data-pane-view]')).toBeTruthy()
+  })
+
+  it('renders a split with both leaves and a divider', () => {
+    const root: PaneNode = {
+      kind: 'split', splitId: 's1', direction: 'row',
+      children: [
+        { kind: 'leaf', paneId: 'a', viewId: 'chat', sessionId: sid('s1') },
+        { kind: 'leaf', paneId: 'b', viewId: 'terminal', sessionId: sid('s2') },
+      ],
+      sizes: [0.5, 0.5],
+    }
+    const { view } = renderTree(root)
+    expect(view.container.querySelector('[data-view-id="chat"]')).toBeTruthy()
+    expect(view.container.querySelector('[data-view-id="terminal"]')).toBeTruthy()
+    expect(view.container.querySelector('[data-direction="row"]')).toBeTruthy()
+  })
+
+  it('renders only the fullscreen leaf when one is set', () => {
+    const root: PaneNode = {
+      kind: 'split', splitId: 's1', direction: 'row',
+      children: [
+        { kind: 'leaf', paneId: 'a', viewId: 'chat', sessionId: sid('s1') },
+        { kind: 'leaf', paneId: 'b', viewId: 'terminal', sessionId: sid('s2') },
+      ],
+      sizes: [0.5, 0.5],
+    }
+    const { view } = renderTree(root, { fullscreenPaneId: 'b' })
+    expect(view.container.querySelector('[data-view-id="terminal"]')).toBeTruthy()
+    expect(view.container.querySelector('[data-view-id="chat"]')).toBeNull()
+  })
+
+  it('fires split/close/fullscreen/focus for a leaf', () => {
+    const { view, onSplit, onClose, onFullscreen, onFocus } = renderTree({ kind: 'leaf', paneId: 'pane-1', viewId: 'chat', sessionId: sid('s1') })
+    fireEvent.click(view.getByRole('button', { name: 'pane.splitRight' }))
+    expect(onSplit).toHaveBeenCalledWith('pane-1', 'row')
+    fireEvent.click(view.getByRole('button', { name: 'pane.splitDown' }))
+    expect(onSplit).toHaveBeenCalledWith('pane-1', 'column')
+    fireEvent.click(view.getByRole('button', { name: 'pane.fullscreen' }))
+    expect(onFullscreen).toHaveBeenCalledWith('pane-1')
+    fireEvent.click(view.getByRole('button', { name: 'pane.close' }))
+    expect(onClose).toHaveBeenCalledWith('pane-1')
+    fireEvent.pointerDown(view.container.querySelector('[data-pane]') as HTMLElement)
+    expect(onFocus).toHaveBeenCalledWith('pane-1')
+  })
+
+  it('drags a divider to resize the two adjacent children', () => {
+    const root: PaneNode = {
+      kind: 'split', splitId: 's1', direction: 'row',
+      children: [
+        { kind: 'leaf', paneId: 'a', viewId: 'chat', sessionId: sid('s1') },
+        { kind: 'leaf', paneId: 'b', viewId: 'terminal', sessionId: sid('s2') },
+      ],
+      sizes: [0.5, 0.5],
+    }
+    const { view, onResize } = renderTree(root)
+    const divider = view.container.querySelector('[data-direction="row"]') as HTMLElement
+    Object.defineProperty(divider.parentElement, 'clientWidth', { value: 100, configurable: true })
+    fireEvent.pointerDown(divider, { clientX: 50 })
+    window.dispatchEvent(new PointerEvent('pointermove', { clientX: 60 }))
+    window.dispatchEvent(new PointerEvent('pointerup'))
+    expect(onResize).toHaveBeenCalledWith('s1', expect.any(Array))
+    const sizes = onResize.mock.calls[0][1] as number[]
+    expect(sizes[0]).toBeCloseTo(0.6)
+    expect(sizes[0] + sizes[1]).toBeCloseTo(1)
+  })
+})
