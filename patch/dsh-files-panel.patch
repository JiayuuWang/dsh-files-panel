+.root {
+  display: flex;
+  flex-direction: column;
+  /* The pane's view div sizes by flex, so height:100% would resolve to auto and
+   * collapse the terminal; grow to fill the pane instead. */
+  flex: 1;
+  min-height: 0;
+  min-width: 0;
+  position: relative;
+}
+
+.toolbar {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: var(--dsw-space-2, 8px);
+  padding: var(--dsw-space-1, 4px) var(--dsw-space-2, 8px);
+  border-bottom: 1px solid var(--dsw-border, rgba(127, 127, 127, 0.2));
+}
+
+.status {
+  font-size: 12px;
+  color: var(--dsw-fg-muted, #888);
+}
+
+.restart {
+  font-size: 12px;
+  padding: 2px 8px;
+  border: 1px solid var(--dsw-border, rgba(127, 127, 127, 0.3));
+  border-radius: 4px;
+  background: transparent;
+  color: inherit;
+  cursor: pointer;
+  white-space: nowrap;
+}
+
+.restart:disabled {
+  opacity: 0.5;
+  cursor: default;
+}
+
+/* Shell picker: a labelled segmented control (clearer than a native dropdown,
+ * which renders poorly against the theme). */
+.shellGroup {
+  display: flex;
+  align-items: center;
+  gap: var(--dsw-space-2, 8px);
+  margin-right: auto;
+  min-width: 0;
+}
+
+.shellLabel {
+  font-size: 12px;
+  color: var(--dsw-fg-muted, #888);
+  white-space: nowrap;
+}
+
+.shellSegments {
+  display: flex;
+  align-items: center;
+  gap: 2px;
+  padding: 2px;
+  border: 1px solid var(--dsw-border, rgba(127, 127, 127, 0.3));
+  border-radius: 6px;
+  background: var(--dsw-bg, rgba(127, 127, 127, 0.08));
+}
+
+.shellSegment {
+  font-size: 12px;
+  line-height: 18px;
+  padding: 1px 8px;
+  border: none;
+  border-radius: 4px;
+  background: transparent;
+  color: var(--dsw-fg-muted, #888);
+  cursor: pointer;
+  white-space: nowrap;
+}
+
