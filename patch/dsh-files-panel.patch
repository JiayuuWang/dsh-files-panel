+
+/**
+ * Bind a subtree to an ARBITRARY listed session (not the current one), for
+ * cross-session panes: a pane hosting a second session renders that session's
+ * `conversation.view` through the standard slot machinery, with `useSession`,
+ * `useStore`, and `useProjection` all resolving to the bound session. Resolves
+ * the session's provide bundle and re-resolves as the session list changes
+ * (session arrival), then remounts the subtree under `key={sessionId}`.
+ */
+export function SessionBoundary({ sessionId, children }: { sessionId: string; children: ReactNode }) {
+  const host = useHost()
+  const list = host.sessions.list
+  // Re-resolve on list changes (session arrival/removal); the bundle itself is
+  // identity-stable once materialized, so this subscription only re-runs on
+  // structural list movement.
+  useSyncExternalStore(
+    fn => list.subscribe(fn),
+    () => list.getSnapshot(),
+  )
+  const info = host.sessions.provideInfoOf(sessionId)
+  if (info === undefined) return null
+  return (
+    <BindingContext.Provider value={info} key={sessionId}>
+      {children}
+    </BindingContext.Provider>
+  )
+}
