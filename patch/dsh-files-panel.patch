@@ -0,0 +1,150 @@
+/** Behavior of the fs-backed workspace-files backend over a real temporary directory tree. */
+
+import { mkdir, mkdtemp, rm, writeFile } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterAll, beforeAll, describe, expect, it } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import LocalFileSystem from '@deepseek-ai/dsh-fs-local'
+import { WorkspaceFilesError } from '@deepseek-ai/dsh-host-workspace-files'
+import FsWorkspaceFiles from '../src/index.ts'
+
+let root: string
+let service: FsWorkspaceFiles
+let dispose: () => Promise<void>
+
+beforeAll(async () => {
+  root = await mkdtemp(join(tmpdir(), 'dsh-workspace-files-'))
+  await mkdir(join(root, 'sub'))
+  await writeFile(join(root, 'a.txt'), 'alpha')
+  await writeFile(join(root, 'b.txt'), 'bravo')
+  await writeFile(join(root, 'c.txt'), 'charlie')
+  await writeFile(join(root, '.hidden.txt'), 'hidden')
+  await writeFile(join(root, 'big.txt'), 'x'.repeat(128))
+  await writeFile(join(root, 'binary.dat'), Buffer.from([0x00, 0xff, 0xfe, 0xfd]))
+
+  const ctx = new Context()
+  const fsFiber = ctx.plugin(LocalFileSystem, { cwd: root })
+  const serviceFiber = ctx.plugin(FsWorkspaceFiles, { maxEntries: 2, maxReadBytes: 64 })
+  await fsFiber.await()
+  await serviceFiber.await()
+  service = ctx.get('workspaceFiles') as FsWorkspaceFiles
+  dispose = async () => {
+    await serviceFiber.dispose()
+    await fsFiber.dispose()
+  }
+})
+
+afterAll(async () => {
+  await dispose()
+  await rm(root, { recursive: true, force: true })
+})
+
+describe('FsWorkspaceFiles.list', () => {
+  it('lists files and directories name-sorted with type, size, and hidden flags', async () => {
+    const listing = await service.list(root)
+    expect(listing.path).toBe(root)
+    expect(listing.truncated).toBe(true)
+    // Name-sorted head under the 2-entry bound.
+    expect(listing.entries.map(entry => entry.name)).toEqual(['.hidden.txt', 'a.txt'])
+    expect(listing.entries.map(entry => entry.type)).toEqual(['file', 'file'])
+    expect(listing.entries.map(entry => entry.hidden)).toEqual([true, false])
+    // Every entry path is absolute and host-joined — clients never join segments.
+    expect(listing.entries.every(entry => entry.path === join(root, entry.name))).toBe(true)
+    expect(listing.entries.every(entry => entry.version !== undefined)).toBe(true)
+    expect(listing.entries.find(entry => entry.name === 'a.txt')?.size).toBe(5)
+  })
+
+  it('reports a complete level untruncated when children fit the bound', async () => {
+    const listing = await service.list(join(root, 'sub'))
+    expect(listing.entries).toEqual([])
+    expect(listing.truncated).toBe(false)
+  })
+
+  it('fails with files-not-found for an absent directory and files-not-directory for a file', async () => {
+    await expect(service.list(join(root, 'gone'))).rejects.toMatchObject({
+      name: 'WorkspaceFilesError',
+      code: 'files-not-found',
+      path: join(root, 'gone'),
+    })
+    await expect(service.list(join(root, 'a.txt'))).rejects.toMatchObject({
+      name: 'WorkspaceFilesError',
+      code: 'files-not-directory',
+      path: join(root, 'a.txt'),
+    })
+  })
+})
+
+describe('FsWorkspaceFiles.read', () => {
+  it('returns the decoded content with its size and freshness version', async () => {
+    const file = await service.read(join(root, 'a.txt'))
+    expect(file).toMatchObject({ path: join(root, 'a.txt'), size: 5, content: 'alpha' })
+    expect(file.version.length).toBeGreaterThan(0)
+  })
+
+  it('fails with files-not-found for an absent file and files-not-file for a directory', async () => {
+    await expect(service.read(join(root, 'gone.txt'))).rejects.toMatchObject({
+      name: 'WorkspaceFilesError',
+      code: 'files-not-found',
+    })
+    await expect(service.read(join(root, 'sub'))).rejects.toMatchObject({
+      name: 'WorkspaceFilesError',
+      code: 'files-not-file',
+    })
+  })
+
+  it('fails with files-too-large for a file at or above the read bound', async () => {
+    await expect(service.read(join(root, 'big.txt'))).rejects.toMatchObject({
+      name: 'WorkspaceFilesError',
+      code: 'files-too-large',
+      path: join(root, 'big.txt'),
+    })
+    const error = await service.read(join(root, 'big.txt')).then(
+      () => { throw new Error('unreachable') },
+      (caught: unknown) => caught,
+    )
+    expect(error).toBeInstanceOf(WorkspaceFilesError)
+    expect((error as WorkspaceFilesError).message).toContain('64-byte read bound')
+  })
+
+  it('fails with files-io-error for non-UTF-8 content the backend rejects', async () => {
+    await expect(service.read(join(root, 'binary.dat'))).rejects.toMatchObject({
+      name: 'WorkspaceFilesError',
+      code: 'files-io-error',
+    })
+  })
+})
+
+describe('FsWorkspaceFiles.write', () => {
+  it('creates a new file and updates an existing one, returning the new version', async () => {
+    const created = await service.write(join(root, 'new.txt'), 'fresh')
+    expect(created).toMatchObject({ path: join(root, 'new.txt'), operation: 'create', size: 5 })
+    expect(created.version.length).toBeGreaterThan(0)
+
+    const updated = await service.write(join(root, 'new.txt'), 'second')
+    expect(updated).toMatchObject({ operation: 'update', size: 6 })
+    expect(await service.read(join(root, 'new.txt'))).toMatchObject({ content: 'second' })
+  })
+
+  it('accepts a matching expected version and rejects a stale one', async () => {
+    const first = await service.read(join(root, 'a.txt'))
+    const guarded = await service.write(join(root, 'a.txt'), 'replaced', first.version)
+    expect(guarded).toMatchObject({ operation: 'update' })
+
+    // The stale token from before the write no longer matches.
+    await expect(service.write(join(root, 'a.txt'), 'clobber', first.version)).rejects.toMatchObject({
+      name: 'WorkspaceFilesError',
+      code: 'files-stale-version',
+      path: join(root, 'a.txt'),
+    })
+    // The mismatched write did not touch the file.
+    expect(await service.read(join(root, 'a.txt'))).toMatchObject({ content: 'replaced' })
+  })
+
+  it('refuses to write a directory with files-not-file', async () => {
+    await expect(service.write(join(root, 'sub'), 'x', undefined)).rejects.toMatchObject({
+      name: 'WorkspaceFilesError',
+      code: 'files-not-file',
+    })
+  })
+})
