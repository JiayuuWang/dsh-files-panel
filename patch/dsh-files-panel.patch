+// @vitest-environment jsdom
+/** FileIcon: extension classification and per-kind glyph rendering. */
+
+import { describe, expect, it } from 'vitest'
+import { render } from '@testing-library/react'
+import { FileIcon, fileIconKind } from '../src/client/FileIcon.tsx'
+
+describe('fileIconKind', () => {
+  it('collapses directories and other non-files to folder', () => {
+    expect(fileIconKind('src', 'directory')).toBe('folder')
+    expect(fileIconKind('socket', 'other')).toBe('folder')
+  })
+
+  it('maps well-known extensions to their glyph family', () => {
+    expect(fileIconKind('app.ts', 'file')).toBe('code')
+    expect(fileIconKind('Component.tsx', 'file')).toBe('code')
+    expect(fileIconKind('pkg.json', 'file')).toBe('json')
+    expect(fileIconKind('README.md', 'file')).toBe('markdown')
+    expect(fileIconKind('index.html', 'file')).toBe('html')
+    expect(fileIconKind('style.css', 'file')).toBe('css')
+    expect(fileIconKind('logo.png', 'file')).toBe('image')
+    expect(fileIconKind('config.yml', 'file')).toBe('config')
+    expect(fileIconKind('note.txt', 'file')).toBe('text')
+  })
+
+  it('falls back to file for extension-less and trailing-dot names', () => {
+    expect(fileIconKind('Makefile', 'file')).toBe('file')
+    expect(fileIconKind('LICENSE.', 'file')).toBe('file')
+    expect(fileIconKind('unknown.zzz', 'file')).toBe('file')
+  })
+})
+
+describe('FileIcon', () => {
+  it('renders the glyph paths for each kind', () => {
+    for (const kind of ['folder', 'code', 'json', 'markdown', 'html', 'css', 'image', 'config', 'text', 'file'] as const) {
+      const { container, unmount } = render(<FileIcon kind={kind} />)
+      expect(container.querySelector(`svg[data-kind="${kind}"]`)).toBeTruthy()
+      expect(container.querySelectorAll('path').length).toBeGreaterThan(0)
+      unmount()
+    }
+  })
+})
