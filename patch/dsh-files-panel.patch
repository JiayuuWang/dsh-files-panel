@@ -0,0 +1,41 @@
+/** Contract behavior the seam itself owns: registration identity and typed failures. */
+
+import { describe, expect, it } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import { WorkspaceFiles, WorkspaceFilesError } from '../src/index.ts'
+import type { FileContent, FileListing, FileWriteOutcome } from '../src/index.ts'
+
+/** Minimal concrete backend: all a subclass owes the abstract class is list(), read(), and write(). */
+class StubWorkspaceFiles extends WorkspaceFiles {
+  async list(): Promise<FileListing> {
+    return { path: '/stub', entries: [], truncated: false }
+  }
+
+  async read(): Promise<FileContent> {
+    return { path: '/stub/file.txt', size: 0, version: 'v1', content: '' }
+  }
+
+  async write(): Promise<FileWriteOutcome> {
+    return { path: '/stub/file.txt', operation: 'update', size: 0, version: 'v2' }
+  }
+}
+
+describe('WorkspaceFiles seam', () => {
+  it('registers a subclass as ctx.workspaceFiles and leaves with its fiber', async () => {
+    const ctx = new Context()
+    const fiber = ctx.plugin(StubWorkspaceFiles)
+    await fiber.await()
+    expect(ctx.get('workspaceFiles')).toBeInstanceOf(StubWorkspaceFiles)
+    await fiber.dispose()
+    expect(ctx.get('workspaceFiles')).toBeUndefined()
+  })
+
+  it('carries the business code and subject path on WorkspaceFilesError', () => {
+    const failure = new WorkspaceFilesError('files-too-large', '/home/u/big.txt', 'cannot read "/home/u/big.txt": exceeds 1048576 bytes')
+    expect(failure.name).toBe('WorkspaceFilesError')
+    expect(failure.code).toBe('files-too-large')
+    expect(failure.path).toBe('/home/u/big.txt')
+    expect(failure.message).toContain('exceeds 1048576 bytes')
+    expect(failure).toBeInstanceOf(Error)
+  })
+})
